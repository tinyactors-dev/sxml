{
  "name": "@tinyactors/sxml",
  "version": "0.2.0",
  "description": "sxml for JavaScript: XML, XPath 4.0, XQuery 4.0, XSLT 4.0 and XSD 1.1 in Node.js and browsers, over WebAssembly",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sxml.wasm": "./dist/sxml.wasm",
    "./sxml-full.wasm": "./dist/sxml-full.wasm",
    "./allkeys.txt": "./dist/allkeys.txt"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.build.json && node -e \"const fs = require('node:fs'); fs.copyFileSync(process.env.SXML_WASM_PATH, 'dist/sxml.wasm'); fs.copyFileSync(process.env.SXML_FULL_WASM_PATH, 'dist/sxml-full.wasm'); fs.copyFileSync('../../third_party/unicode-collation/allkeys.txt', 'dist/allkeys.txt')\"",
    "test": "node --expose-gc --test test/package.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
