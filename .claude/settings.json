{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|EnterWorktree|Agent|mcp__github__create_branch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/main-only.py\""
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/spec-nodes-only.py\""
          }
        ]
      }
    ]
  }
}
