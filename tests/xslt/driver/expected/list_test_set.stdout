set-basic basic-function
  stylesheet principal tests/insn/basic/basic-function.xsl
  stylesheet secondary tests/insn/basic/inc/included.xsl
  param s select 'yes' as xs:string static
  param f:p Q{http://example.com/f}p select 42
  invoke call-function f:go Q{http://example.com/f}go
    param - select 1 as xs:integer
    param - select 'two'
  output serialize file tests/insn/basic/out/basic-function.xml
  plan stylesheet tests/insn/basic/basic-function.xsl, 1 secondary, 1 static, 1 parameters, delivery serialized
  assertions all-of 1 assert-string-value 1 assert-xml 1 serialization-matches 1 assert-message 1 assert-result-document 1
