<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns="urn:sxml:schematron-test-suite" name="diagnostics-properties">
  <description>diagnostic and property elements referenced from assertions.</description>
  <spec clause="5.4.3"/>
  <spec clause="5.4.14"/>
  <spec clause="5.5.1"/>
  <spec clause="5.5.2"/>
  <spec clause="5.5.3"/>
  <spec clause="5.5.11"/>
  <spec clause="5.5.12"/>
  <spec clause="5.5.13"/>
  <spec clause="6.3"/>
  <spec clause="Annex-A"/>
  <spec clause="Annex-J"/>

  <test-case name="diagnostic-basic" since="2020">
    <description>A failed assert carries the diagnostic it references.</description>
    <spec clause="5.5.1"/>
    <spec clause="5.5.2"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-basic.sch"/>
    <instance file="diagnostic-basic.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[3]">
          <message>Below three.</message>
          <diagnostic ref="too-big">Lower the value.</diagnostic>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="diagnostic-several-languages" since="2020">
    <description>Several diagnostics, one per language, in one diagnostics attribute.</description>
    <spec clause="5.5.1"/>
    <spec clause="5.5.2"/>
    <spec clause="Annex-G"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-several-languages.sch"/>
    <instance file="diagnostic-several-languages.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[3]">
          <message>Below three.</message>
          <diagnostic ref="d-en" lang="en">The value is too large.</diagnostic>
          <diagnostic ref="d-de" lang="de">Der Wert ist zu gross.</diagnostic>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="diagnostic-dynamic" since="2020">
    <description>value-of and name in a diagnostic are evaluated for the finding's context node.</description>
    <spec clause="5.5.1"/>
    <spec clause="6.3"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-dynamic.sch"/>
    <instance file="diagnostic-dynamic.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[2]">
          <message>Below two.</message>
          <diagnostic ref="found">The item has n = 2.</diagnostic>
        </finding>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[3]">
          <message>Below two.</message>
          <diagnostic ref="found">The item has n = 3.</diagnostic>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="diagnostic-rule-variable" since="2020">
    <description>The variables in scope for the assertion are in scope in its diagnostic.</description>
    <spec clause="5.5.1"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-rule-variable.sch"/>
    <instance file="diagnostic-rule-variable.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[3]">
          <message>Doubled below six.</message>
          <diagnostic ref="show">Doubled: 6.</diagnostic>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="diagnostic-on-report" since="2020">
    <description>A fired report carries its diagnostic.</description>
    <spec clause="5.4.14"/>
    <spec clause="5.5.2"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-on-report.sch"/>
    <instance file="diagnostic-on-report.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[1]">
          <message>One.</message>
          <diagnostic ref="one" role="note">A note about one.</diagnostic>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="diagnostic-not-when-passing" since="2020">
    <description>An assertion that holds yields nothing, its diagnostic included.</description>
    <spec clause="5.5.1"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-not-when-passing.sch"/>
    <instance file="diagnostic-not-when-passing.xml"/>
    <result>
      <findings/>
    </result>
  </test-case>

  <test-case name="diagnostic-unreferenced" since="2020">
    <description>A diagnostic that no assertion references is not part of any finding.</description>
    <spec clause="5.5.3"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-unreferenced.sch"/>
    <instance file="diagnostic-unreferenced.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[3]">
          <message>Below three.</message>
          <diagnostic ref="used">Used.</diagnostic>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="diagnostic-unknown" since="2020">
    <description>diagnostics names an id that no diagnostic has.</description>
    <spec clause="5.5.2"/>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-unknown.sch"/>
    <instance file="diagnostic-unknown.xml"/>
    <result>
      <schema-error clause="Annex-A"/>
    </result>
  </test-case>

  <test-case name="property-basic" since="2020">
    <description>A finding carries the properties its assertion references, with role and scheme.</description>
    <spec clause="5.5.11"/>
    <spec clause="5.5.13"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="property-basic.sch"/>
    <instance file="property-basic.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[2]">
          <message>Priced.</message>
          <property ref="currency" role="unit" scheme="urn:example:currencies">EUR</property>
          <property ref="precision" role="digits">2</property>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="property-dynamic" since="2020">
    <description>value-of in a property is evaluated for the context node; the variables in scope for the assertion are in scope.</description>
    <spec clause="5.5.13"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="property-dynamic.sch"/>
    <instance file="property-dynamic.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[3]">
          <message>Below three.</message>
          <property ref="value" role="value">3 squared is 9</property>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="property-copy-of" since="2020">
    <description>Under xslt3 an xsl:copy-of without children may be used in a property; its result is part of the property's content.</description>
    <spec clause="5.5.13"/>
    <spec clause="Annex-J"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="property-copy-of.sch"/>
    <instance file="property-copy-of.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[1]">
          <message>One.</message>
          <property ref="copy" role="contents">Copied: 1</property>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="property-unknown" since="2020">
    <description>properties names an id that no property has.</description>
    <spec clause="5.5.11"/>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="property-unknown.sch"/>
    <instance file="property-unknown.xml"/>
    <result>
      <schema-error clause="Annex-A"/>
    </result>
  </test-case>

  <test-case name="diagnostic-and-property" since="2020">
    <description>An assertion with both diagnostics and properties.</description>
    <spec clause="5.5.2"/>
    <spec clause="5.5.11"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-and-property.sch"/>
    <instance file="diagnostic-and-property.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[2]">
          <message>Not two.</message>
          <diagnostic ref="d">Change the two.</diagnostic>
          <property ref="p">two</property>
        </finding>
      </findings>
    </result>
  </test-case>
  <test-case name="diagnostic-dynamic-error" since="2020">
    <description>A dynamic error in the diagnostic of a failed assertion: validation ends in error.</description>
    <spec clause="5.5.1"/>
    <spec clause="6.1"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-dynamic-error.sch"/>
    <instance file="diagnostic-dynamic-error.xml"/>
    <result>
      <error clause="6.1"/>
    </result>
  </test-case>

  <test-case name="property-dynamic-error" since="2020">
    <description>A dynamic error in a property of a fired report: validation ends in error.</description>
    <spec clause="5.5.13"/>
    <spec clause="6.1"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="property-dynamic-error.sch"/>
    <instance file="property-dynamic-error.xml"/>
    <result>
      <error clause="6.1"/>
    </result>
  </test-case>

  <test-case name="diagnostic-value-of-syntax" since="2020">
    <description>A value-of in a diagnostic whose select is not an expression of the query language.</description>
    <spec clause="5.5.1"/>
    <spec clause="7.2"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-value-of-syntax.sch"/>
    <instance file="diagnostic-value-of-syntax.xml"/>
    <result>
      <schema-error clause="7.2"/>
    </result>
  </test-case>

  <test-case name="property-value-of-syntax" since="2020">
    <description>A value-of in a property whose select is not an expression of the query language.</description>
    <spec clause="5.5.13"/>
    <spec clause="7.2"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="property-value-of-syntax.sch"/>
    <instance file="property-value-of-syntax.xml"/>
    <result>
      <schema-error clause="7.2"/>
    </result>
  </test-case>

  <test-case name="diagnostic-shared" since="2020">
    <description>One diagnostic referenced by two assertions; two diagnostics referenced by one, in reverse order of declaration.</description>
    <spec clause="5.5.1"/>
    <spec clause="5.5.2"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-shared.sch"/>
    <instance file="diagnostic-shared.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[2]">
          <message>Not two.</message>
          <diagnostic ref="first">First for 2.</diagnostic>
          <diagnostic ref="second">Second.</diagnostic>
        </finding>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[3]">
          <message>Not three.</message>
          <diagnostic ref="first">First for 3.</diagnostic>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="property-several" since="2020">
    <description>Several properties on one report, one of them shared with another report, with name and value-of.</description>
    <spec clause="5.5.13"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="property-several.sch"/>
    <instance file="property-several.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[2]">
          <message>Two.</message>
          <property ref="kind" role="kind">An item.</property>
          <property ref="value" scheme="urn:example:scheme">Value 2.</property>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[3]">
          <message>Three.</message>
          <property ref="value" scheme="urn:example:scheme">Value 3.</property>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="diagnostic-property-subject-context" since="2020">
    <description>value-of in a diagnostic and a property of an assertion that has a subject.</description>
    <spec clause="5.5.1"/>
    <spec clause="5.5.13"/>
    <spec clause="6.3"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-property-subject-context.sch"/>
    <instance file="diagnostic-property-subject-context.xml"/>
    <result>
      <implementation-defined clause="6.3 5.5.1 5.5.13">6.3 makes the subject the context of name and value-of in the message (Not two: doc.); it says nothing of diagnostics and properties, whose context may be the subject (doc) or the rule's context node (item). One failed-assert at /Q{}doc[1].</implementation-defined>
    </result>
  </test-case>

  <test-case name="diagnostic-phase-variable" since="2020">
    <description>A variable of the active phase is in scope in a diagnostic, as in the assertion.</description>
    <spec clause="5.5.1"/>
    <spec clause="5.4.7"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-phase-variable.sch"/>
    <instance file="diagnostic-phase-variable.xml"/>
    <phase>p</phase>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[3]">
          <message>Within.</message>
          <diagnostic ref="d">Limit 2.</diagnostic>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="diagnostic-abstract-parameter" since="2020">
    <description>A diagnostic referenced from an abstract pattern refers to $e, a parameter of that pattern.</description>
    <spec clause="6.2"/>
    <spec clause="6.4"/>
    <spec clause="5.5.1"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-abstract-parameter.sch"/>
    <instance file="diagnostic-abstract-parameter.xml"/>
    <result>
      <implementation-defined clause="6.2 6.4">6.2 replaces parameters in the attributes of the abstract pattern; the diagnostic sits outside it. If it is replaced, the diagnostic reads Count 3.; if not, $e is a reference to an undefined variable (an error).</implementation-defined>
    </result>
  </test-case>

  <test-case name="property-visit-each" since="2025">
    <description>A property's value-of evaluated for each item visit-each selects (here atomic values).</description>
    <spec clause="5.5.13"/>
    <spec clause="5.5.21"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="property-visit-each.sch"/>
    <instance file="property-visit-each.xml"/>
    <result>
      <findings>
        <finding kind="successful-report">
          <message>Found b.</message>
          <property ref="p">Code b.</property>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="diagnostic-non-ascii" since="2020">
    <description>A diagnostic in Arabic with dir and xml:lang, and one in Greek: the language and the text are kept.</description>
    <spec clause="5.5.1"/>
    <spec clause="5.5.4"/>
    <spec clause="6.7"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="diagnostic-non-ascii.sch"/>
    <instance file="diagnostic-non-ascii.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[2]">
          <message>Not two.</message>
          <diagnostic ref="ar" lang="ar">ليس اثنين.</diagnostic>
          <diagnostic ref="el" lang="el">Όχι δύο.</diagnostic>
        </finding>
      </findings>
    </result>
  </test-case>
  <test-case name="ancillary-namespaces" since="2020">
    <description>A subject, a diagnostic and a property that use a prefix declared by ns, differing from the instance's; the property's text is non-ASCII.</description>
    <spec clause="5.5.19"/>
    <spec clause="5.5.1"/>
    <spec clause="5.5.13"/>
    <spec clause="5.4.10"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="ancillary-namespaces.sch"/>
    <instance file="ancillary-namespaces.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[2]/@Q{urn:example:q}code">
          <message>Not b2.</message>
        </finding>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[2]">
          <message>Again.</message>
          <diagnostic ref="d">Diagnostic b2.</diagnostic>
          <property ref="p">Eigenschaft ä b2.</property>
        </finding>
      </findings>
    </result>
  </test-case>
</test-set>
