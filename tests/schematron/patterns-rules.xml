<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns="urn:sxml:schematron-test-suite" name="patterns-rules">
  <description>Which rules fire: rule order within a pattern, several patterns, the kinds of node a rule context matches, and the subject of a finding.</description>
  <spec clause="3.13"/>
  <spec clause="3.19"/>
  <spec clause="3.20"/>
  <spec clause="3.21"/>
  <spec clause="3.22"/>
  <spec clause="5.4.12"/>
  <spec clause="5.4.15"/>
  <spec clause="5.5.19"/>
  <spec clause="6.3"/>
  <spec clause="6.6"/>

  <test-case name="rules-empty-pattern" since="2020">
    <description>A pattern without rules is allowed and finds nothing.</description>
    <spec clause="5.4.12"/>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-empty-pattern.sch"/>
    <instance file="rules-empty-pattern.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[1]">
          <message>Item one.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-never-fires" since="2020">
    <description>A rule whose context matches nothing is not an error.</description>
    <spec clause="5.4.15"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-never-fires.sch"/>
    <instance file="rules-never-fires.xml"/>
    <result>
      <findings/>
    </result>
  </test-case>

  <test-case name="rules-first-match-wins" since="2020">
    <description>Two rules with the same context in a pattern: only the first fires.</description>
    <spec clause="3.20"/>
    <spec clause="6.3"/>
    <spec clause="6.6"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-first-match-wins.sch"/>
    <instance file="rules-first-match-wins.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[1]">
          <message>First rule.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-specific-then-general" since="2020">
    <description>A specific rule before a general one: each node fires only the first rule that matches it.</description>
    <spec clause="3.20"/>
    <spec clause="6.6"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-specific-then-general.sch"/>
    <instance file="rules-specific-then-general.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[1]">
          <message>Plain item 1.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[2]">
          <message>Special item 2.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[3]">
          <message>Plain item 3.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-general-then-specific" since="2020">
    <description>A general rule before a specific one: the specific rule never fires.</description>
    <spec clause="3.20"/>
    <spec clause="6.6"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-general-then-specific.sch"/>
    <instance file="rules-general-then-specific.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[2]">
          <message>Plain item.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-passing-rule-still-blocks" since="2020">
    <description>A node matched by an earlier rule whose assertions all hold is not offered to a later rule.</description>
    <spec clause="3.20"/>
    <spec clause="6.3"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-passing-rule-still-blocks.sch"/>
    <instance file="rules-passing-rule-still-blocks.xml"/>
    <result>
      <findings/>
    </result>
  </test-case>

  <test-case name="rules-attribute-not-blocked" since="2020">
    <description>A rule for an element does not block a later rule for one of its attributes: they are different nodes.</description>
    <spec clause="3.20"/>
    <spec clause="6.3"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-attribute-not-blocked.sch"/>
    <instance file="rules-attribute-not-blocked.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}list[1]/Q{}entry[1]">
          <message>Entry.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}list[1]/Q{}entry[1]/@kind">
          <message>Kind x.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-predicate-position" since="2020">
    <description>A rule for the first item before a rule for every item.</description>
    <spec clause="3.9"/>
    <spec clause="3.20"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-predicate-position.sch"/>
    <instance file="rules-predicate-position.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[1]">
          <message>First.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[2]">
          <message>Other 2.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[3]">
          <message>Other 3.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-same-node-two-patterns" since="2020">
    <description>Each pattern is evaluated on its own: a node matched in two patterns fires a rule in each.</description>
    <spec clause="3.13"/>
    <spec clause="6.3"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-same-node-two-patterns.sch"/>
    <instance file="rules-same-node-two-patterns.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[3]">
          <message>Pattern a.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[3]">
          <message>Pattern b.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-all-assertions-evaluated" since="2020">
    <description>Every assertion of a fired rule is evaluated: three failures on one node.</description>
    <spec clause="6.3"/>
    <spec clause="6.6"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-all-assertions-evaluated.sch"/>
    <instance file="rules-all-assertions-evaluated.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[1]">
          <message>Has a.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[1]">
          <message>Has n.</message>
        </finding>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[1]">
          <message>Has b.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-many-nodes" since="2020">
    <description>A rule fires for every node it matches; the failures are reported per node.</description>
    <spec clause="6.3"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-many-nodes.sch"/>
    <instance file="rules-many-nodes.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[1]">
          <message>Only two.</message>
        </finding>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[3]">
          <message>Only two.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-context-root" since="2020">
    <description>A rule context that matches the document node.</description>
    <spec clause="Annex-J"/>
    <spec clause="6.3"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-context-root.sch"/>
    <instance file="rules-context-root.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/">
          <message>Three items.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-context-document-element" since="2020">
    <description>A rule context with an absolute path.</description>
    <spec clause="Annex-J"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-context-document-element.sch"/>
    <instance file="rules-context-document-element.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]">
          <message>Three items.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-context-attribute" since="2020">
    <description>A rule context that matches attributes.</description>
    <spec clause="Annex-J"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-context-attribute.sch"/>
    <instance file="rules-context-attribute.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[3]/@n">
          <message>An n below 3.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-context-comment" since="2020">
    <description>A rule context that matches comments.</description>
    <spec clause="Annex-J"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-context-comment.sch"/>
    <instance file="rules-context-comment.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/comment()[2]">
          <message>A TODO comment.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-context-processing-instruction" since="2020">
    <description>A rule context that matches processing instructions.</description>
    <spec clause="Annex-J"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-context-processing-instruction.sch"/>
    <instance file="rules-context-processing-instruction.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/processing-instruction(page)[2]">
          <message>A positive page.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-context-text" since="2020">
    <description>Text nodes as rule context: an implementation may allow them at user option or reject the schema.</description>
    <spec clause="Annex-J"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-context-text.sch"/>
    <instance file="rules-context-text.xml"/>
    <result>
      <implementation-defined clause="Annex-J">Text nodes as a rule context are allowed at user option; when allowed, the finding is a successful-report at /Q{}doc[1]/Q{}a[1]/text()[1].</implementation-defined>
    </result>
  </test-case>

  <test-case name="rules-context-union" since="2020">
    <description>A rule context that is a union of patterns.</description>
    <spec clause="Annex-J"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-context-union.sch"/>
    <instance file="rules-context-union.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}a[1]">
          <message>a.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}b[1]">
          <message>b.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-context-descendant" since="2020">
    <description>A rule context with a descendant step matches at any depth.</description>
    <spec clause="Annex-J"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-context-descendant.sch"/>
    <instance file="rules-context-descendant.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}leaf[1]">
          <message>Leaf.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}branch[1]/Q{}leaf[1]">
          <message>Leaf.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}branch[1]/Q{}branch[1]/Q{}leaf[1]">
          <message>Leaf.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-nested-matches" since="2020">
    <description>A rule fires for nested nodes that it matches at every level.</description>
    <spec clause="6.3"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-nested-matches.sch"/>
    <instance file="rules-nested-matches.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}section[1]/Q{}section[1]">
          <message>A section has a title.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-subject-on-assert" since="2020">
    <description>The subject attribute of an assert gives the location of its finding.</description>
    <spec clause="5.5.19"/>
    <spec clause="6.3"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-subject-on-assert.sch"/>
    <instance file="rules-subject-on-assert.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[2]/@n">
          <message>Not two.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-subject-on-rule" since="2020">
    <description>The subject attribute of a rule gives the location of its assertions' findings.</description>
    <spec clause="5.5.19"/>
    <spec clause="6.3"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-subject-on-rule.sch"/>
    <instance file="rules-subject-on-rule.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}order[1]/Q{}total[1]">
          <message>The total is the sum of the lines.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-subject-assert-over-rule" since="2020">
    <description>An assert's subject takes precedence over its rule's.</description>
    <spec clause="5.5.19"/>
    <spec clause="6.3"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-subject-assert-over-rule.sch"/>
    <instance file="rules-subject-assert-over-rule.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}order[1]/Q{}line[2]">
          <message>On the second line.</message>
        </finding>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}order[1]/Q{}total[1]">
          <message>On the total.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-abstract-false" since="2020">
    <description>abstract="false" written out on a pattern and a rule.</description>
    <spec clause="5.4.12"/>
    <spec clause="5.4.15"/>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-abstract-false.sch"/>
    <instance file="rules-abstract-false.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[3]">
          <message>Item three.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-dynamic-error" since="2020">
    <description>A dynamic error in an assertion test: validation ends in error.</description>
    <spec clause="6.1"/>
    <spec clause="7.1"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-dynamic-error.sch"/>
    <instance file="rules-dynamic-error.xml"/>
    <result>
      <error clause="6.1"/>
    </result>
  </test-case>

  <test-case name="rules-predeclared-xs-prefix" since="2020">
    <description>The xs prefix is not declared by ns: whether the binding predeclares it is the query language's matter.</description>
    <spec clause="5.4.10"/>
    <spec clause="Annex-J"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-predeclared-xs-prefix.sch"/>
    <instance file="rules-predeclared-xs-prefix.xml"/>
    <result>
      <implementation-defined clause="5.4.10 Annex-J">Every prefix in a query shall be declared by ns; XPath and XSLT predeclare xs. A processor that keeps XPath's predeclared prefixes finds nothing; one that applies 5.4.10 strictly rejects the schema.</implementation-defined>
    </result>
  </test-case>
  <test-case name="rules-identical-findings-two-patterns" since="2020">
    <description>Two patterns with the same rule: each is evaluated, so the instance has two identical findings (findings are a multiset).</description>
    <spec clause="6.3"/>
    <spec clause="3.13"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-identical-findings-two-patterns.sch"/>
    <instance file="rules-identical-findings-two-patterns.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[2]">
          <message>Not two.</message>
        </finding>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[2]">
          <message>Not two.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-order-several-patterns" since="2020">
    <description>Three patterns report on one node; the order of the findings is implementation-dependent (6.6), their multiset is not.</description>
    <spec clause="6.6"/>
    <spec clause="6.3"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-order-several-patterns.sch"/>
    <instance file="rules-order-several-patterns.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[2]">
          <message>Third.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[2]">
          <message>First.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[2]">
          <message>Second.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-context-reverse-order" since="2020">
    <description>Under xpath31 a rule context that returns nodes in reverse document order: the rule fires for each, with the same findings.</description>
    <spec clause="6.3"/>
    <spec clause="Annex-L"/>
    <dependency type="query-binding" value="xpath31"/>
    <schema file="rules-context-reverse-order.sch"/>
    <instance file="rules-context-reverse-order.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[2]">
          <message>Not two.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-context-duplicates" since="2020">
    <description>Under xpath31 a rule context that returns every node twice.</description>
    <spec clause="3.20"/>
    <spec clause="6.3"/>
    <spec clause="Annex-L"/>
    <dependency type="query-binding" value="xpath31"/>
    <schema file="rules-context-duplicates.sch"/>
    <instance file="rules-context-duplicates.xml"/>
    <result>
      <implementation-defined clause="3.20 6.3">A rule fires for the information items its context matches; whether a node returned twice is matched once (one successful-report at /Q{}doc[1]/Q{}item[2]) or evaluated for each item of the sequence (two) is not said.</implementation-defined>
    </result>
  </test-case>

  <test-case name="rules-context-namespaced-attribute" since="2020">
    <description>A rule context that matches attributes in a namespace, with a prefix that differs from the instance's; an attribute of the same local name in no namespace is not matched.</description>
    <spec clause="5.4.10"/>
    <spec clause="Annex-J"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-context-namespaced-attribute.sch"/>
    <instance file="rules-context-namespaced-attribute.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[2]/@Q{urn:example:q}code">
          <message>Code b2 starts with a capital.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-context-whitespace-text" since="2025">
    <description>Under xquery31 whitespace-only text nodes of the instance may be rule contexts; nothing strips them.</description>
    <spec clause="Annex-N"/>
    <dependency type="query-binding" value="xquery31"/>
    <schema file="rules-context-whitespace-text.sch"/>
    <instance file="rules-context-whitespace-text.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/text()[1]">
          <message>Whitespace.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/text()[2]">
          <message>Whitespace.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="rules-context-whitespace-text-xslt3" since="2020">
    <description>Whitespace-only text nodes as rule context under xslt3.</description>
    <spec clause="Annex-J"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-context-whitespace-text-xslt3.sch"/>
    <instance file="rules-context-whitespace-text-xslt3.xml"/>
    <result>
      <implementation-defined clause="Annex-J">Text nodes as rule context are allowed at user option; when allowed, two successful-reports at /Q{}doc[1]/text()[1] and /Q{}doc[1]/text()[2] (the binding strips no whitespace).</implementation-defined>
    </result>
  </test-case>

  <test-case name="rules-subject-dynamic-error" since="2020">
    <description>A dynamic error in the subject of a failed assertion: validation ends in error.</description>
    <spec clause="5.5.19"/>
    <spec clause="6.1"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-subject-dynamic-error.sch"/>
    <instance file="rules-subject-dynamic-error.xml"/>
    <result>
      <error clause="6.1"/>
    </result>
  </test-case>

  <test-case name="rules-subject-syntax" since="2020">
    <description>A subject that is not an expression of the query language.</description>
    <spec clause="5.5.19"/>
    <spec clause="7.2"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-subject-syntax.sch"/>
    <instance file="rules-subject-syntax.xml"/>
    <result>
      <schema-error clause="7.2"/>
    </result>
  </test-case>

  <test-case name="rules-subject-empty" since="2020">
    <description>A subject that selects nothing for a failed assertion.</description>
    <spec clause="5.5.19"/>
    <spec clause="6.3"/>
    <spec clause="Annex-D"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-subject-empty.sch"/>
    <instance file="rules-subject-empty.xml"/>
    <result>
      <implementation-defined clause="5.5.19">5.5.19 does not say what identifies the finding when the subject path selects nothing: the rule's context node (a failed-assert at /Q{}doc[1]/Q{}item[2]), no location, or an error.</implementation-defined>
    </result>
  </test-case>

  <test-case name="rules-subject-several" since="2020">
    <description>A subject that selects several nodes.</description>
    <spec clause="5.5.19"/>
    <spec clause="6.3"/>
    <spec clause="Annex-D"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-subject-several.sch"/>
    <instance file="rules-subject-several.xml"/>
    <result>
      <implementation-defined clause="5.5.19">The subject is a path to the nodes of interest; how a finding is located when it selects three nodes (the first, each of them, the rule's context node /Q{}doc[1]) and what the context of name and value-of then is, is not said. One failed-assert, message Two items.</implementation-defined>
    </result>
  </test-case>

  <test-case name="rules-subject-attribute" since="2020">
    <description>A subject that selects an attribute of the context node.</description>
    <spec clause="5.5.19"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="rules-subject-attribute.sch"/>
    <instance file="rules-subject-attribute.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[2]/@n">
          <message>Not two.</message>
        </finding>
