<?xml version="1.0" encoding="UTF-8"?>
<!-- The format of the Schematron conformance suite: the catalog, the test-set
     files and the coverage list. See README.md. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:sxml:schematron-test-suite"
           targetNamespace="urn:sxml:schematron-test-suite"
           elementFormDefault="qualified">

  <!-- A clause of ISO/IEC 19757-3:2025: 5.4.7, 6.3, Annex-B. -->
  <xs:simpleType name="clause">
    <xs:restriction base="xs:token">
      <xs:pattern value="[1-7](\.[0-9]+)*|Annex-[A-O]"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="clauses">
    <xs:restriction>
      <xs:simpleType><xs:list itemType="t:clause"/></xs:simpleType>
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="edition">
    <xs:restriction base="xs:token">
      <xs:enumeration value="2020"/>
      <xs:enumeration value="2025"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="description" type="xs:string"/>
  <xs:element name="spec">
    <xs:complexType><xs:attribute name="clause" type="t:clause" use="required"/></xs:complexType>
  </xs:element>

  <!-- The catalog: the test sets. -->
  <xs:element name="catalog">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="t:description"/>
        <xs:element name="test-set" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="name" type="xs:NCName" use="required"/>
            <xs:attribute name="file" type="xs:anyURI" use="required"/>
            <xs:attribute name="title" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="standard" type="xs:string" use="required"/>
    </xs:complexType>
    <xs:unique name="unique-test-set">
      <xs:selector xpath="t:test-set"/>
      <xs:field xpath="@name"/>
    </xs:unique>
  </xs:element>

  <!-- A test set: the cases of one clause group. -->
  <xs:element name="test-set">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="t:description"/>
        <xs:element ref="t:spec" maxOccurs="unbounded"/>
        <xs:element ref="t:test-case" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
    </xs:complexType>
    <xs:unique name="unique-test-case">
      <xs:selector xpath="t:test-case"/>
      <xs:field xpath="@name"/>
    </xs:unique>
  </xs:element>

  <xs:element name="test-case">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="t:description"/>
        <xs:element ref="t:spec" maxOccurs="unbounded"/>
        <xs:element name="dependency" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="type" use="required">
              <xs:simpleType>
                <xs:restriction base="xs:token">
                  <xs:enumeration value="query-binding"/>
                  <xs:enumeration value="feature"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="value" type="xs:token" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="schema" type="t:file"/>
        <xs:element name="instance" type="t:file"/>
        <xs:element name="phase" type="xs:string" minOccurs="0"/>
        <xs:element name="param" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="name" type="xs:NCName" use="required"/>
            <xs:attribute name="value" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element ref="t:result"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:NCName" use="required"/>
      <xs:attribute name="since" type="t:edition" default="2020"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="file">
    <xs:attribute name="file" type="xs:anyURI" use="required"/>
  </xs:complexType>

  <!-- The expected result: one of four outcomes. -->
  <xs:element name="result">
    <xs:complexType>
      <xs:choice>
        <xs:sequence>
          <xs:element name="findings">
            <xs:complexType>
              <xs:sequence>
                <xs:element ref="t:finding" minOccurs="0" maxOccurs="unbounded"/>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="flags" minOccurs="0">
            <xs:simpleType><xs:list itemType="xs:NMTOKEN"/></xs:simpleType>
          </xs:element>
          <xs:element name="assert-svrl" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:element ref="t:schema-error"/>
        <xs:element ref="t:error"/>
        <xs:element name="implementation-defined" type="t:outcome"/>
        <xs:element name="any-of">
          <xs:complexType>
            <xs:choice minOccurs="2" maxOccurs="unbounded">
              <xs:element ref="t:schema-error"/>
              <xs:element ref="t:error"/>
            </xs:choice>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="outcome">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="clause" type="t:clauses" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:element name="schema-error" type="t:outcome"/>
  <xs:element name="error" type="t:outcome"/>

  <xs:element name="finding">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="message" type="xs:string"/>
        <xs:element name="diagnostic" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:string">
                <xs:attribute name="ref" type="xs:NCName" use="required"/>
                <xs:attribute name="role" type="xs:string"/>
                <xs:attribute name="lang" type="xs:language"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
        <xs:element name="property" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:string">
                <xs:attribute name="ref" type="xs:NCName" use="required"/>
                <xs:attribute name="role" type="xs:string"/>
                <xs:attribute name="scheme" type="xs:string"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="kind" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:token">
            <xs:enumeration value="failed-assert"/>
            <xs:enumeration value="successful-report"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <!-- The subject node as fn:path gives it (XPath 3.1); absent when the
           subject is not a node and the location is not compared. -->
      <xs:attribute name="location" type="xs:string"/>
      <xs:attribute name="id" type="xs:NCName"/>
      <xs:attribute name="role" type="xs:string"/>
      <xs:attribute name="flag" type="xs:string"/>
      <xs:attribute name="severity" type="xs:string"/>
      <!-- A subordinate document, relative to the test set's directory. -->
      <xs:attribute name="document" type="xs:anyURI"/>
    </xs:complexType>
  </xs:element>

  <!-- The coverage list: each normative requirement and the cases for it. -->
  <xs:element name="coverage">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="t:description"/>
        <xs:element name="requirement" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="text" type="xs:string"/>
              <xs:choice>
                <xs:element name="test" maxOccurs="unbounded">
                  <xs:complexType>
                    <xs:attribute name="set" type="xs:NCName" use="required"/>
                    <xs:attribute name="case" type="xs:NCName" use="required"/>
                  </xs:complexType>
                </xs:element>
                <xs:element name="untested" type="xs:string"/>
              </xs:choice>
            </xs:sequence>
            <xs:attribute name="id" type="xs:ID" use="required"/>
            <xs:attribute name="clause" type="t:clause" use="required"/>
            <xs:attribute name="kind" use="required">
              <xs:simpleType>
                <xs:restriction base="xs:token">
                  <xs:enumeration value="shall"/>
                  <xs:enumeration value="should"/>
                  <xs:enumeration value="may"/>
                  <xs:enumeration value="definition"/>
                  <xs:enumeration value="implementation-defined"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
