  <test-case name="phase-from-several" since="2025">
    <description>A from that selects two subtrees in reverse document order: rule contexts are evaluated in both, with the same findings as in document order.</description>
    <spec clause="5.5.7"/>
    <spec clause="6.6"/>
    <schema file="phase-from-several.sch"/>
    <instance file="phase-from-several.xml"/>
    <phase>p</phase>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}part[1]/Q{}item[1]">
          <message>Item 1.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}part[1]/Q{}item[2]">
          <message>Item 2.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}part[2]/Q{}item[1]">
          <message>Item 3.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="phase-from-overlapping" since="2025">
    <description>A from whose results overlap: a part and an item inside it.</description>
    <spec clause="5.5.7"/>
    <schema file="phase-from-overlapping.sch"/>
    <instance file="phase-from-overlapping.xml"/>
    <phase>p</phase>
    <result>
      <implementation-defined clause="5.5.7">The results of from become the context for rule contexts; 5.5.7 does not say whether a node reached from two results is evaluated once (successful-reports for items 1 and 2 of the first part) or once for each (item 1 twice).</implementation-defined>
    </result>
  </test-case>

  <test-case name="phase-from-attributes" since="2025">
    <description>A from that selects attribute nodes: rule contexts that match attributes are evaluated against them.</description>
    <spec clause="5.5.7"/>
    <schema file="phase-from-attributes.sch"/>
    <instance file="phase-from-attributes.xml"/>
    <phase>p</phase>
    <result>
      <implementation-defined clause="5.5.7">5.5.7 does not say how the selected nodes become the context for rule contexts when they are attributes: whether the selected attribute itself is matched (one successful-report at /Q{}doc[1]/Q{}part[2]/@n, Number 2.) or only nodes below it (none).</implementation-defined>
    </result>
  </test-case>

