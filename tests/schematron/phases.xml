    <instance file="phase-when-ebv.xml"/>
    <phase>#ANY</phase>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[2]">
          <message>Pattern b.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="phase-when-ebv-error" since="2025">
