    <spec clause="3.3"/>
    <schema file="phase-inactive-pattern-dynamic-error.sch"/>
    <instance file="phase-inactive-pattern-dynamic-error.xml"/>
    <phase>p</phase>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[2]">
          <message>Two.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="phase-inactive-pattern-syntax-error" since="2020">
    <description>A syntax error in a pattern outside the active phase: whether a schema is correct does not depend on the phase.</description>
    <spec clause="7.2"/>
    <schema file="phase-inactive-pattern-syntax-error.sch"/>
    <instance file="phase-inactive-pattern-syntax-error.xml"/>
    <phase>p</phase>
    <result>
