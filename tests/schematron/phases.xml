    <spec clause="5.5.22"/>
    <spec clause="6.1"/>
    <schema file="phase-when-dynamic-error.sch"/>
    <instance file="phase-when-dynamic-error.xml"/>
    <phase>#ANY</phase>
    <result>
      <error clause="6.1"/>
    </result>
  </test-case>

  <test-case name="phase-when-syntax" since="2025">
    <description>A when that is not an expression of the query language.</description>
    <spec clause="5.5.22"/>
    <spec clause="7.2"/>
    <schema file="phase-when-syntax.sch"/>
    <instance file="phase-when-syntax.xml"/>
    <result>
      <schema-error clause="7.2"/>
    </result>
  </test-case>

  <test-case name="phase-any-later-when-error" since="2025">
    <description>#ANY where the first phase's when is true and a later phase's when would raise a dynamic error.</description>
    <spec clause="5.5.22"/>
    <schema file="phase-any-later-when-error.sch"/>
    <instance file="phase-any-later-when-error.xml"/>
    <phase>#ANY</phase>
    <result>
      <implementation-defined clause="5.5.22">The first phase in document order whose when is true is active; 5.5.22 does not say whether the when of later phases is evaluated: one successful-report at /Q{}doc[1]/Q{}item[2], or an error.</implementation-defined>
    </result>
  </test-case>

  <test-case name="phase-when-ebv" since="2025">
