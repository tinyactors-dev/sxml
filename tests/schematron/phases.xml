  <test-case name="phase-non-ascii-id" since="2020">
    <description>A phase and a pattern whose ids have non-ASCII letters.</description>
    <spec clause="5.4.13"/>
    <spec clause="7.2"/>
    <schema file="phase-non-ascii-id.sch"/>
    <instance file="phase-non-ascii-id.xml"/>
    <phase>prüfung</phase>
    <result>
      <findings>
