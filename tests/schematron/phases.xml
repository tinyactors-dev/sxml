          <message>A Item 2.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}part[1]/Q{}item[2]">
          <message>B Item 2.</message>
        </finding>
      </findings>
    </result>
  </test-case>

