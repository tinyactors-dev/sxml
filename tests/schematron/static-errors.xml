<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns="urn:sxml:schematron-test-suite" name="static-errors">
  <description>Schemas that are not correct Schematron schemas: well-formedness, the grammar of Annex A, the constraints of Annex B, names and the grammars of the query language binding.</description>
  <spec clause="5.1"/>
  <spec clause="5.2"/>
  <spec clause="5.4.1"/>
  <spec clause="7.1"/>
  <spec clause="7.2"/>
  <spec clause="Annex-A"/>
  <spec clause="Annex-B"/>

  <test-case name="error-not-well-formed" since="2020">
    <description>A schema document that is not well-formed (the file is deliberately broken).</description>
    <spec clause="5.1"/>
    <schema file="error-not-well-formed.sch.txt"/>
    <instance file="error-not-well-formed.xml"/>
    <result>
      <schema-error clause="5.1"/>
    </result>
  </test-case>

  <test-case name="error-old-namespace" since="2020">
    <description>Elements in the namespace of the pre-ISO Schematron 1.5 are not Schematron.</description>
    <spec clause="5.2"/>
    <spec clause="Annex-A"/>
    <schema file="error-old-namespace.sch"/>
    <instance file="error-old-namespace.xml"/>
    <result>
      <schema-error clause="5.2"/>
    </result>
  </test-case>

  <test-case name="error-no-pattern" since="2020">
    <description>A schema needs at least one pattern or group.</description>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-no-pattern.sch"/>
    <instance file="error-no-pattern.xml"/>
    <result>
      <schema-error clause="Annex-A"/>
    </result>
  </test-case>

  <test-case name="error-unknown-element" since="2020">
    <description>An element in the Schematron namespace that the grammar does not define.</description>
    <spec clause="Annex-A"/>
    <spec clause="5.2"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-unknown-element.sch"/>
    <instance file="error-unknown-element.xml"/>
    <result>
      <schema-error clause="Annex-A"/>
    </result>
  </test-case>

  <test-case name="error-unqualified-attribute" since="2020">
    <description>An attribute in no namespace that the grammar does not define on rule (foreign attributes need a namespace).</description>
    <spec clause="Annex-A"/>
    <spec clause="5.2"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-unqualified-attribute.sch"/>
    <instance file="error-unqualified-attribute.xml"/>
    <result>
      <schema-error clause="Annex-A 5.2"/>
    </result>
  </test-case>

  <test-case name="error-rule-without-assertion" since="2020">
    <description>A rule needs at least one assert, report, extends or p.</description>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-rule-without-assertion.sch"/>
    <instance file="error-rule-without-assertion.xml"/>
    <result>
      <schema-error clause="Annex-A"/>
    </result>
  </test-case>

  <test-case name="error-rule-without-context" since="2020">
    <description>A rule that is not abstract needs a context attribute.</description>
    <spec clause="5.4.15"/>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-rule-without-context.sch"/>
    <instance file="error-rule-without-context.xml"/>
    <result>
      <schema-error clause="5.4.15"/>
    </result>
  </test-case>

  <test-case name="error-assert-without-test" since="2020">
    <description>An assert needs a test attribute.</description>
    <spec clause="5.4.3"/>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-assert-without-test.sch"/>
    <instance file="error-assert-without-test.xml"/>
    <result>
      <schema-error clause="5.4.3"/>
    </result>
  </test-case>

  <test-case name="error-report-without-test" since="2020">
    <description>A report needs a test attribute.</description>
    <spec clause="5.4.14"/>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-report-without-test.sch"/>
    <instance file="error-report-without-test.xml"/>
    <result>
      <schema-error clause="5.4.14"/>
    </result>
  </test-case>

  <test-case name="error-ns-after-pattern" since="2020">
    <description>ns comes before the patterns in the schema element's content.</description>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-ns-after-pattern.sch"/>
    <instance file="error-ns-after-pattern.xml"/>
    <result>
      <schema-error clause="Annex-A"/>
    </result>
  </test-case>

  <test-case name="error-two-diagnostics-sections" since="2020">
    <description>A schema has at most one diagnostics element.</description>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-two-diagnostics-sections.sch"/>
    <instance file="error-two-diagnostics-sections.xml"/>
    <result>
      <schema-error clause="Annex-A"/>
    </result>
  </test-case>

  <test-case name="error-duplicate-id" since="2020">
    <description>id attributes are of type ID: a pattern and an assert may not share one.</description>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-duplicate-id.sch"/>
    <instance file="error-duplicate-id.xml"/>
    <result>
      <schema-error clause="Annex-A"/>
    </result>
  </test-case>

  <test-case name="error-id-not-a-name" since="2020">
    <description>An id must be a well-formed name.</description>
    <spec clause="7.2"/>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-id-not-a-name.sch"/>
    <instance file="error-id-not-a-name.xml"/>
    <result>
      <schema-error clause="7.2"/>
    </result>
  </test-case>

  <test-case name="error-flag-not-a-name" since="2020">
    <description>A flag must be a well-formed name.</description>
    <spec clause="7.2"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-flag-not-a-name.sch"/>
    <instance file="error-flag-not-a-name.xml"/>
    <result>
      <schema-error clause="7.2"/>
    </result>
  </test-case>

  <test-case name="error-let-name-not-a-name" since="2020">
    <description>A variable name must be a well-formed name.</description>
    <spec clause="7.2"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-let-name-not-a-name.sch"/>
    <instance file="error-let-name-not-a-name.xml"/>
    <result>
      <schema-error clause="7.2"/>
    </result>
  </test-case>

  <test-case name="error-ns-prefix-not-a-name" since="2020">
    <description>An ns prefix must be a name without a colon.</description>
    <spec clause="5.4.10"/>
    <spec clause="7.2"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-ns-prefix-not-a-name.sch"/>
    <instance file="error-ns-prefix-not-a-name.xml"/>
    <result>
      <schema-error clause="5.4.10"/>
    </result>
  </test-case>

  <test-case name="error-ns-without-uri" since="2020">
    <description>ns needs a uri attribute.</description>
    <spec clause="5.4.10"/>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-ns-without-uri.sch"/>
    <instance file="error-ns-without-uri.xml"/>
    <result>
      <schema-error clause="5.4.10"/>
    </result>
  </test-case>

  <test-case name="error-context-syntax" since="2020">
    <description>A rule context that is not a pattern of the query language.</description>
    <spec clause="7.2"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-context-syntax.sch"/>
    <instance file="error-context-syntax.xml"/>
    <result>
      <schema-error clause="7.2"/>
    </result>
  </test-case>

  <test-case name="error-test-syntax" since="2020">
    <description>An assertion test that is not an expression of the query language.</description>
    <spec clause="7.2"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-test-syntax.sch"/>
    <instance file="error-test-syntax.xml"/>
    <result>
      <schema-error clause="7.2"/>
    </result>
  </test-case>

  <test-case name="error-context-is-expression" since="2020">
    <description>Under xslt3 a rule context is an XSLT pattern: an expression that is not a pattern is a syntax error.</description>
    <spec clause="7.2"/>
    <spec clause="Annex-J"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-context-is-expression.sch"/>
    <instance file="error-context-is-expression.xml"/>
    <result>
      <schema-error clause="Annex-J"/>
    </result>
  </test-case>

  <test-case name="error-undeclared-prefix" since="2020">
    <description>A prefix in a test that no ns element declares.</description>
    <spec clause="5.4.10"/>
    <spec clause="7.2"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-undeclared-prefix.sch"/>
    <instance file="error-undeclared-prefix.xml"/>
    <result>
      <schema-error clause="5.4.10"/>
    </result>
  </test-case>

  <test-case name="error-xmlns-not-used-for-queries" since="2020">
    <description>A prefix bound only by an XML namespace declaration is not in scope for queries.</description>
    <spec clause="5.4.10"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-xmlns-not-used-for-queries.sch"/>
    <instance file="error-xmlns-not-used-for-queries.xml"/>
    <result>
      <schema-error clause="5.4.10"/>
    </result>
  </test-case>

  <test-case name="error-phase-id-missing" since="2020">
    <description>A phase needs an id.</description>
    <spec clause="5.4.13"/>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-phase-id-missing.sch"/>
    <instance file="error-phase-id-missing.xml"/>
    <result>
      <schema-error clause="5.4.13"/>
    </result>
  </test-case>

  <test-case name="error-diagnostics-in-pattern" since="2020">
    <description>diagnostics is a child of the schema (or a library), not of a pattern.</description>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-diagnostics-in-pattern.sch"/>
    <instance file="error-diagnostics-in-pattern.xml"/>
    <result>
      <schema-error clause="Annex-A"/>
    </result>
  </test-case>

  <test-case name="error-dir-bad-value" since="2020">
    <description>The value of dir is ltr or rtl.</description>
    <spec clause="5.5.4"/>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-dir-bad-value.sch"/>
    <instance file="error-dir-bad-value.xml"/>
    <result>
      <schema-error clause="5.5.4"/>
    </result>
  </test-case>

  <test-case name="error-span-without-class" since="2020">
    <description>span needs a class attribute.</description>
    <spec clause="5.5.18"/>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-span-without-class.sch"/>
    <instance file="error-span-without-class.xml"/>
    <result>
      <schema-error clause="5.5.18"/>
    </result>
  </test-case>

  <test-case name="error-value-of-without-select" since="2020">
    <description>value-of needs a select attribute.</description>
    <spec clause="5.4.18"/>
    <spec clause="Annex-A"/>
    <dependency type="query-binding" value="xslt3"/>
    <schema file="error-value-of-without-select.sch"/>
    <instance file="error-value-of-without-select.xml"/>
    <result>
      <schema-error clause="5.4.18"/>
    </result>
  </test-case>
</test-set>
