  </test-case>

  <test-case name="let-as-mismatch" since="2025">
    <description>A value that does not match the declared type is a type error.</description>
    <spec clause="5.4.7"/>
    <spec clause="Annex-J"/>
    <schema file="let-as-mismatch.sch"/>
    <instance file="let-as-mismatch.xml"/>
    <result>
      <any-of>
        <error clause="Annex-J"/>
        <schema-error clause="Annex-J"/>
      </any-of>
    </result>
  </test-case>

  <test-case name="param-schema" since="2025">
    <description>A schema parameter is a variable with its value attribute's value.</description>
    <spec clause="5.4.11"/>
    <spec clause="3.23"/>
    <schema file="param-schema.sch"/>
    <instance file="param-schema.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[3]">
          <message>Within the limit.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="param-schema-override" since="2025">
    <description>A schema parameter's value may be overridden at user option (the mechanism is implementation-defined); overridden with 3 here.</description>
    <spec clause="5.4.11"/>
    <spec clause="6.1"/>
    <dependency type="feature" value="schema-parameter-override"/>
    <schema file="param-schema-override.sch"/>
    <instance file="param-schema-override.xml"/>
    <param name="limit" value="3"/>
    <result>
      <findings/>
    </result>
  </test-case>

  <test-case name="param-schema-without-value" since="2025">
    <description>A schema parameter needs a value.</description>
    <spec clause="5.4.11"/>
    <spec clause="Annex-B"/>
    <schema file="param-schema-without-value.sch"/>
    <instance file="param-schema-without-value.xml"/>
    <result>
