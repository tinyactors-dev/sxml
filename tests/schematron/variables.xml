<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns="urn:sxml:schematron-test-suite" name="variables">
  <description>let in schema, phase, pattern and rule: context, scope, order, duplicates, typed variables (as) and schema parameters.</description>
  <spec clause="3.23"/>
  <spec clause="5.4.7"/>
  <spec clause="5.4.11"/>
  <spec clause="6.6"/>
  <spec clause="7.2"/>
  <spec clause="Annex-B"/>
  <spec clause="Annex-J"/>

  <test-case name="let-rule-value" since="2020">
    <description>A rule variable is evaluated for each context node.</description>
    <spec clause="5.4.7"/>
    <schema file="let-rule-value.sch"/>
    <instance file="let-rule-value.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[2]">
          <message>Not two.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-rule-context-node" since="2020">
    <description>The context of a rule variable is the rule's context node.</description>
    <spec clause="5.4.7"/>
    <schema file="let-rule-context-node.sch"/>
    <instance file="let-rule-context-node.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[1]">
          <message>At item.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-pattern-root-context" since="2020">
    <description>A pattern variable is evaluated with the document node as context (count(*) is 1 there).</description>
    <spec clause="5.4.7"/>
    <schema file="let-pattern-root-context.sch"/>
    <instance file="let-pattern-root-context.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[1]">
          <message>Children of the root: 1.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-schema-root-context" since="2020">
    <description>A schema variable is evaluated with the document node as context.</description>
    <spec clause="5.4.7"/>
    <schema file="let-schema-root-context.sch"/>
    <instance file="let-schema-root-context.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[3]">
          <message>Last of 3, root children 1.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-phase" since="2020">
    <description>A variable of the active phase is in scope in its active patterns.</description>
    <spec clause="5.4.7"/>
    <spec clause="5.4.13"/>
    <schema file="let-phase.sch"/>
    <instance file="let-phase.xml"/>
    <phase>strict</phase>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[3]">
          <message>At most 2.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-in-rule-context" since="2020">
    <description>A schema variable used in a rule context.</description>
    <spec clause="5.4.7"/>
    <spec clause="Annex-J"/>
    <schema file="let-in-rule-context.sch"/>
    <instance file="let-in-rule-context.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[3]">
          <message>Above the limit.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-pattern-in-rule-context" since="2020">
    <description>A pattern variable used in a rule context of that pattern.</description>
    <spec clause="5.4.7"/>
    <spec clause="Annex-J"/>
    <schema file="let-pattern-in-rule-context.sch"/>
    <instance file="let-pattern-in-rule-context.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[1]">
          <message>The first.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-in-subject" since="2020">
    <description>A rule variable used in a subject attribute.</description>
    <spec clause="5.4.7"/>
    <spec clause="5.5.19"/>
    <schema file="let-in-subject.sch"/>
    <instance file="let-in-subject.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[2]/@n">
          <message>Two.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-in-name-path" since="2020">
    <description>A rule variable used in the path of a name element.</description>
    <spec clause="5.4.7"/>
    <spec clause="5.4.9"/>
    <schema file="let-in-name-path.sch"/>
    <instance file="let-in-name-path.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[1]">
