      </findings>
    </result>
  </test-case>

  <test-case name="let-as-promotion" since="2025">
    <description>A typed variable converts its value by the rules of XSLT's as attribute: an integer becomes a double.</description>
    <spec clause="5.4.7"/>
    <spec clause="Annex-J"/>
    <schema file="let-as-promotion.sch"/>
    <instance file="let-as-promotion.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]">
          <message>Promoted.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-as-untyped" since="2025">
