  <test-case name="param-schema-duplicate" since="2025">
    <description>Parameter names are distinct within a schema.</description>
    <spec clause="5.4.11"/>
    <spec clause="Annex-B"/>
    <schema file="param-schema-duplicate.sch"/>
    <instance file="param-schema-duplicate.xml"/>
    <result>
