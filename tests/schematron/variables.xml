  <test-case name="let-order-in-rule" since="2020">
    <description>A rule variable may use a lexically previous one.</description>
    <spec clause="6.6"/>
    <schema file="let-order-in-rule.sch"/>
    <instance file="let-order-in-rule.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[2]">
          <message>Twenty.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-rule-uses-global" since="2020">
    <description>A rule variable may use a schema variable.</description>
    <spec clause="6.6"/>
    <schema file="let-rule-uses-global.sch"/>
    <instance file="let-rule-uses-global.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[3]">
          <message>Thirty.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-forward-reference" since="2020">
    <description>A rule variable may not use a variable declared after it in the same rule.</description>
    <spec clause="6.6"/>
    <spec clause="5.4.7"/>
    <schema file="let-forward-reference.sch"/>
    <instance file="let-forward-reference.xml"/>
    <result>
      <schema-error clause="6.6"/>
    </result>
  </test-case>

  <test-case name="let-undefined" since="2020">
    <description>A reference to a variable that no let defines.</description>
    <spec clause="5.4.7"/>
    <schema file="let-undefined.sch"/>
    <instance file="let-undefined.xml"/>
