  </test-case>

  <test-case name="let-same-name-two-patterns" since="2020">
    <description>A pattern variable is scoped to its pattern: two patterns may each define a variable of the same name, and each sees its own.</description>
    <spec clause="3.23"/>
    <spec clause="5.4.7"/>
    <schema file="let-same-name-two-patterns.sch"/>
    <instance file="let-same-name-two-patterns.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]">
          <message>In pattern a.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]">
          <message>In pattern b.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-pattern-not-visible-elsewhere" since="2020">
    <description>A pattern variable is not in scope in another pattern.</description>
    <spec clause="3.23"/>
    <spec clause="5.4.7"/>
    <schema file="let-pattern-not-visible-elsewhere.sch"/>
    <instance file="let-pattern-not-visible-elsewhere.xml"/>
    <result>
      <schema-error clause="3.23 5.4.7"/>
    </result>
  </test-case>

  <test-case name="let-same-name-two-rules" since="2020">
    <description>A rule variable is scoped to its rule: two rules may each define one of the same name.</description>
    <spec clause="3.23"/>
    <spec clause="5.4.7"/>
    <schema file="let-same-name-two-rules.sch"/>
    <instance file="let-same-name-two-rules.xml"/>
    <result>
      <findings>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[1]">
          <message>The first.</message>
        </finding>
        <finding kind="successful-report" location="/Q{}doc[1]/Q{}item[3]">
          <message>The other.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-element-content" since="2020">
    <description>A let without a value attribute takes its element content as value.</description>
    <spec clause="5.4.7"/>
    <spec clause="Annex-A"/>
    <schema file="let-element-content.sch"/>
    <instance file="let-element-content.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[3]">
          <message>At most the configured maximum.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-value-is-sequence" since="2020">
    <description>A variable's value may be any sequence, not only a string.</description>
    <spec clause="5.4.7"/>
    <spec clause="Annex-J"/>
    <schema file="let-value-is-sequence.sch"/>
    <instance file="let-value-is-sequence.xml"/>
    <result>
      <findings>
        <finding kind="failed-assert" location="/Q{}doc[1]/Q{}item[2]">
          <message>An allowed n.</message>
        </finding>
      </findings>
    </result>
  </test-case>

  <test-case name="let-value-is-node" since="2020">
