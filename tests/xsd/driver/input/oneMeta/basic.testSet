<testSet xmlns="http://www.w3.org/XML/2004/xml-schema-test-suite/" xmlns:xlink="http://www.w3.org/1999/xlink" name="Basic" contributor="Small" version="1.1">
  <testGroup name="a">
    <annotation><documentation>A schema and two instances.</documentation></annotation>
    <schemaTest name="a.xsd">
      <schemaDocument xlink:href="../oneData/a.xsd"/>
      <expected validity="valid"/>
      <current status="accepted" date="2026-10-18"/>
    </schemaTest>
    <instanceTest name="a.v.xml">
      <instanceDocument xlink:href="../oneData/a.v.xml"/>
      <expected validity="valid"/>
      <current status="accepted" date="2026-10-18"/>
    </instanceTest>
    <instanceTest name="a.n.xml">
      <instanceDocument xlink:href="../oneData/a.n.xml"/>
      <expected validity="invalid"/>
      <current status="stable" date="2026-10-18"/>
      <prior status="queried" date="2026-01-01"/>
    </instanceTest>
  </testGroup>
  <testGroup name="b">
    <schemaTest name="b">
      <schemaDocument xlink:href="../oneData/b1.xsd"/>
      <schemaDocument xlink:href="../oneData/sub/../b2.xsd"/>
      <expected validity="invalid"/>
    </schemaTest>
  </testGroup>
  <testGroup name="built-in">
    <instanceTest name="plain">
      <instanceDocument xlink:href="../oneData/a.v.xml"/>
      <expected validity="invalid"/>
    </instanceTest>
  </testGroup>
</testSet>
