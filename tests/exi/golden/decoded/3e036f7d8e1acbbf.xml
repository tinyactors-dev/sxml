<?xml version="1.0" encoding="UTF-8"?><ns3:test-set xmlns:ns3="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-identity" covers-40="fn-identity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><ns3:description>Tests for the fn:identity function (4.0 proposal)</ns3:description><ns3:link type="spec" document="http://www.w3.org/TR/xpath-functions-11/" idref="func-identity"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test-case name="identity-001"><ns3:description>Empty sequence</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>identity(())</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="identity-002"><ns3:description>Element</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test> name(identity(&lt;_/&gt;)) </ns3:test><ns3:result><ns3:assert-string-value>_</ns3:assert-string-value></ns3:result></ns3:test-case><ns3:test-case name="identity-003"><ns3:description>Sequence (I)</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>identity(1 to 6)</ns3:test><ns3:result><ns3:assert-deep-eq>1, 2, 3, 4, 5, 6</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="identity-004"><ns3:description>Sequence (II)</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>reverse(9 to 10000) =&gt; sort((), identity#1) =&gt; head()</ns3:test><ns3:result><ns3:assert-eq>9</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="identity-005"><ns3:description>Instance of check</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>identity(true#0) instance of function() as xs:boolean</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case></ns3:test-set>