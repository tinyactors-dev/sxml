<?xml version="1.0" encoding="UTF-8"?><ns3:test-set xmlns:ns3="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-location" covers-40="PR2839" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><ns3:description>Tests for the XPath 4.0 fn:location function</ns3:description><ns3:test-case name="fn-location-001"><ns3:description> Evaluation of the fn:location function with an undefined context node and no argument. </ns3:description><ns3:created by="Michael Kay" on="2026-08-18"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test>
        location()
      </ns3:test><ns3:result><ns3:error code="XPDY0002"/></ns3:result></ns3:test-case><ns3:test-case name="fn-location-002"><ns3:description> Evaluation of the fn:location function applied to an empty sequence. </ns3:description><ns3:created by="Michael Kay" on="2026-08-18"/><ns3:modified by="Christian Gruen" on="2026-08-25" change="syntax"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test>
        location(())
      </ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="fn-location-003"><ns3:description> Evaluation of the fn:location function applied to an element supplied as source. </ns3:description><ns3:created by="Michael Kay" on="2026-08-18"/><ns3:environment ref="works"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test>
        location(//employee[4])
      </ns3:test><ns3:result><ns3:any-of><ns3:assert-empty/><ns3:all-of><ns3:assert>ends-with($result?system-id, 'works.xml') or empty($result?system-id)</ns3:assert><ns3:assert>empty($result?public-id)</ns3:assert><ns3:assert>$result?line-number = 18 or empty($result?line-number)</ns3:assert><ns3:assert>$result?column-number = (1 to 13) or empty($result?column-number)</ns3:assert></ns3:all-of></ns3:any-of></ns3:result></ns3:test-case><ns3:test-case name="fn-location-004"><ns3:description> Evaluation of the fn:location function applied to an element obtained using doc(). </ns3:description><ns3:created by="Michael Kay" on="2026-08-18"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test>
        let $works := doc('../docs/works.xml', {'retain-location': true()})
        return location($works//employee[4])
      </ns3:test><ns3:result><ns3:any-of><ns3:assert-empty/><ns3:all-of><ns3:assert>ends-with($result?system-id, 'works.xml') or empty($result?system-id)</ns3:assert><ns3:assert>empty($result?public-id)</ns3:assert><ns3:assert>$result?line-number = 18 or empty($result?line-number)</ns3:assert><ns3:assert>$result?column-number = (1 to 13) or empty($result?column-number)</ns3:assert></ns3:all-of></ns3:any-of></ns3:result></ns3:test-case><ns3:test-case name="fn-location-005"><ns3:description> Evaluation of the fn:location function applied to an element obtained using parse-xml(). </ns3:description><ns3:created by="Michael Kay" on="2026-08-18"/><ns3:modified by="Christian Gruen" on="2026-08-25" change="syntax"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test>
        let $doc := parse-xml(`&lt;a&gt;{char(10)} &lt;b/&gt;{char(10)} &lt;b/&gt;&lt;/a&gt;`, {'retain-location': true()})
        return location($doc//b[2])       
      </ns3:test><ns3:result><ns3:any-of><ns3:assert-empty/><ns3:all-of><ns3:assert>$result?line-number = 3 or empty($result?line-number)</ns3:assert><ns3:assert>$result?column-number = (2 to 6) or empty($result?column-number)</ns3:assert></ns3:all-of></ns3:any-of></ns3:result></ns3:test-case></ns3:test-set>