<?xml version="1.0" encoding="UTF-8"?><ns3:test-set xmlns:ns3="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-index-of-substring" covers-40="PR2951" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><ns3:description>Tests for the fn:index-of-substring function</ns3:description><ns3:link type="spec" document="https://qt4cg.org/specifications/xpath-functions-40/" idref="func-index-of-substring"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test-case name="index-of-substring-001"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("banana", "an")</ns3:test><ns3:result><ns3:assert-deep-eq>2, 4</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-002"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("banana", "a")</ns3:test><ns3:result><ns3:assert-deep-eq>2, 4, 6</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-003"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("banana", "ana")</ns3:test><ns3:result><ns3:assert-deep-eq>2, 4</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-004"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("aaaa", "aa")</ns3:test><ns3:result><ns3:assert-deep-eq>1, 2, 3</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-005"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("banana", "x")</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-006"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("banana", "banana")</ns3:test><ns3:result><ns3:assert-deep-eq>1</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-007"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("banana", "bananas")</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-008"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("", "a")</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-009"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring((), "a")</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-010"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("abc", "")</ns3:test><ns3:result><ns3:assert-deep-eq>1, 2, 3, 4</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-011"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("", "")</ns3:test><ns3:result><ns3:assert-deep-eq>1</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-012"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring((), "")</ns3:test><ns3:result><ns3:assert-deep-eq>1</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-013"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring(char(0x1F600) || "a" || char(0x1F600) || "a", "a")</ns3:test><ns3:result><ns3:assert-deep-eq>2, 4</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-014"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("a" || char(0x301) || "a", "a")</ns3:test><ns3:result><ns3:assert-deep-eq>1, 3</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-015"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("ABC", "b")</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-016"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>
      declare default collation
        'http://www.w3.org/2005/xpath-functions/collation/html-ascii-case-insensitive';
      fn:index-of-substring("ABC", "b")
    </ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-017"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring(xs:untypedAtomic("abcab"), "b")</ns3:test><ns3:result><ns3:assert-deep-eq>2, 5</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-018"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("abc", "c") instance of xs:integer+</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-019"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("a.b.c", ".") =&gt; foot()</ns3:test><ns3:result><ns3:assert-eq>4</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-020"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring(string-join((1 to 1000) ! "ab"), "b") =&gt; count()</ns3:test><ns3:result><ns3:assert-eq>1000</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-021"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring("abc", ())</ns3:test><ns3:result><ns3:assert-deep-eq>1, 2, 3, 4</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="index-of-substring-022"><ns3:description>Evaluation of the index-of-substring function.</ns3:description><ns3:created by="Christian Gruen" on="2026-09-29"/><ns3:test>fn:index-of-substring(12321, "2")</ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case></ns3:test-set>