<?xml version="1.0" encoding="UTF-8"?><ns3:test-set xmlns:ns3="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-parts-of-dateTime" covers-40="PR2416" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><ns3:description>Tests for the parts-of-datetime() function</ns3:description><ns3:link type="spec" document="https://qt4cg.org/specifications/xpath-functions-40/Overview.html" idref="func-parts-of-dateTime"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test-case name="fn-parts-of-dateTime-dateTimeStamp-with-timezone"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is an xs:dateTimeStamp</ns3:description><ns3:created by="Sheila Thomson" on="2026-02-18"/><ns3:modified by="Michael Kay" on="2026-03-12" change="add check on specific type of result fields"/><ns3:modified by="Sheila Thomson" on="2026-03-26" change="tweaked name and description"/><ns3:test>fn:parts-of-dateTime(xs:dateTime("1999-05-31T13:20:00-05:00"))</ns3:test><ns3:result><ns3:all-of><ns3:assert-count>1</ns3:assert-count><ns3:assert-type>fn:dateTime-record</ns3:assert-type><ns3:assert>$result?year treat as xs:integer eq 1999</ns3:assert><ns3:assert>$result?month treat as xs:integer eq 5</ns3:assert><ns3:assert>$result?day treat as xs:integer eq 31</ns3:assert><ns3:assert>$result?hours treat as xs:integer eq 13</ns3:assert><ns3:assert>$result?minutes treat as xs:integer eq 20</ns3:assert><ns3:assert>$result?seconds treat as xs:decimal eq 0</ns3:assert><ns3:assert>$result?timezone treat as xs:dayTimeDuration eq xs:dayTimeDuration("-PT5H")</ns3:assert><ns3:assert>map:size($result) eq 7</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-dateTimeStamp-with-timezone-utc-z"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is an xs:dateTimeStamp, with UTC timezone represented as 'Z'.</ns3:description><ns3:created by="Sheila Thomson" on="2026-03-19"/><ns3:modified by="Sheila Thomson" on="2026-03-26" change="tweaked name and description"/><ns3:test>fn:parts-of-dateTime(xs:dateTime("2000-06-12T13:20:00Z"))</ns3:test><ns3:result><ns3:all-of><ns3:assert-count>1</ns3:assert-count><ns3:assert-type>fn:dateTime-record</ns3:assert-type><ns3:assert>$result?"year" eq 2000</ns3:assert><ns3:assert>$result?"month" eq 06</ns3:assert><ns3:assert>$result?"day" eq 12</ns3:assert><ns3:assert>$result?"hours" eq 13</ns3:assert><ns3:assert>$result?"minutes" eq 20</ns3:assert><ns3:assert>$result?"seconds" eq 0</ns3:assert><ns3:assert>$result?"timezone" eq xs:dayTimeDuration("PT0S")</ns3:assert><ns3:assert>map:size($result) eq 7</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-dateTime-without-timezone"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is an xs:dateTime, without a timezone value.</ns3:description><ns3:created by="Sheila Thomson" on="2026-02-21"/><ns3:modified by="Sheila Thomson" on="2026-03-19" change="removed trailing 'Z' from input; expected size reduced to 6 and timezone now expected empty"/><ns3:modified by="Sheila Thomson" on="2026-03-26" change="tweaked name"/><ns3:modified by="Christian Gruen" on="2026-07-01" change="PR2566"/><ns3:test>fn:parts-of-dateTime(xs:dateTime("2000-06-12T13:20:00"))</ns3:test><ns3:result><ns3:all-of><ns3:assert-count>1</ns3:assert-count><ns3:assert-type>fn:dateTime-record</ns3:assert-type><ns3:assert>$result?"year" eq 2000</ns3:assert><ns3:assert>$result?"month" eq 06</ns3:assert><ns3:assert>$result?"day" eq 12</ns3:assert><ns3:assert>$result?"hours" eq 13</ns3:assert><ns3:assert>$result?"minutes" eq 20</ns3:assert><ns3:assert>$result?"seconds" eq 0</ns3:assert><ns3:assert>empty($result?"timezone")</ns3:assert><ns3:assert>map:size($result) eq 7</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-date"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is an xs:date</ns3:description><ns3:created by="Sheila Thomson" on="2026-02-18"/><ns3:modified by="Sheila Thomson" on="2026-03-19" change="expected size reduced to 3 and timezone now expected empty"/><ns3:modified by="Christian Gruen" on="2026-07-01" change="PR2566"/><ns3:test>fn:parts-of-dateTime(xs:date("2026-02-21"))</ns3:test><ns3:result><ns3:all-of><ns3:assert-count>1</ns3:assert-count><ns3:assert-type>fn:dateTime-record</ns3:assert-type><ns3:assert>$result?"year" eq 2026</ns3:assert><ns3:assert>$result?"month" eq 2</ns3:assert><ns3:assert>$result?"day" eq 21</ns3:assert><ns3:assert>empty($result?"hours")</ns3:assert><ns3:assert>empty($result?"minutes")</ns3:assert><ns3:assert>empty($result?"seconds")</ns3:assert><ns3:assert>empty($result?"timezone")</ns3:assert><ns3:assert>map:size($result) eq 7</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-time-microsecond-precision"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is an xs:time, with minimum required precision</ns3:description><ns3:created by="Sheila Thomson" on="2026-02-18"/><ns3:modified by="Sheila Thomson" on="2026-03-19" change="expected size reduced to 3"/><ns3:modified by="Sheila Thomson" on="2026-03-26" change="tweaked name and description"/><ns3:modified by="Christian Gruen" on="2026-07-01" change="PR2566"/><ns3:test>fn:parts-of-dateTime(xs:time("13:30:04.2678"))</ns3:test><ns3:result><ns3:all-of><ns3:assert-count>1</ns3:assert-count><ns3:assert-type>fn:dateTime-record</ns3:assert-type><ns3:assert>empty($result?"year")</ns3:assert><ns3:assert>empty($result?"month")</ns3:assert><ns3:assert>empty($result?"day")</ns3:assert><ns3:assert>$result?"hours" eq 13</ns3:assert><ns3:assert>$result?"minutes" eq 30</ns3:assert><ns3:assert>$result?"seconds" eq 4.2678</ns3:assert><ns3:assert>empty($result?"timezone")</ns3:assert><ns3:assert>map:size($result) eq 7</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-time-midnight-as-24"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is an xs:time, and the hour is set to '24'. Value ranges not expected to be validated so record expected, not an error.</ns3:description><ns3:created by="Sheila Thomson" on="2026-03-20"/><ns3:modified by="Christian Gruen" on="2026-07-01" change="PR2566"/><ns3:test>fn:parts-of-dateTime(xs:time("24:00:00"))</ns3:test><ns3:result><ns3:all-of><ns3:assert-count>1</ns3:assert-count><ns3:assert-type>fn:dateTime-record</ns3:assert-type><ns3:assert>empty($result?"year")</ns3:assert><ns3:assert>empty($result?"month")</ns3:assert><ns3:assert>empty($result?"day")</ns3:assert><ns3:assert>$result?"hours" eq 0</ns3:assert><ns3:assert>$result?"minutes" eq 0</ns3:assert><ns3:assert>$result?"seconds" eq 0</ns3:assert><ns3:assert>empty($result?"timezone")</ns3:assert><ns3:assert>map:size($result) eq 7</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-dateTime-midnight-as-24"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is an xs:dateTime, and the hour is set to '24'. Value ranges not expected to be validated so record expected, not an error.</ns3:description><ns3:created by="Sheila Thomson" on="2026-03-20"/><ns3:modified by="Christian Gruen" on="2026-07-01" change="PR2566"/><ns3:test>fn:parts-of-dateTime(xs:dateTime("1999-12-31T24:00:00"))</ns3:test><ns3:result><ns3:all-of><ns3:assert-count>1</ns3:assert-count><ns3:assert-type>fn:dateTime-record</ns3:assert-type><ns3:assert>$result?"year" eq 2000</ns3:assert><ns3:assert>$result?"month" eq 1</ns3:assert><ns3:assert>$result?"day" eq 1</ns3:assert><ns3:assert>$result?"hours" eq 0</ns3:assert><ns3:assert>$result?"minutes" eq 0</ns3:assert><ns3:assert>$result?"seconds" eq 0</ns3:assert><ns3:assert>empty($result?"timezone")</ns3:assert><ns3:assert>map:size($result) eq 7</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-gYear"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is an xs:gYear</ns3:description><ns3:created by="Sheila Thomson" on="2026-02-18"/><ns3:modified by="Sheila Thomson" on="2026-03-19" change="expected size reduced to 1"/><ns3:modified by="Christian Gruen" on="2026-07-01" change="PR2566"/><ns3:test>fn:parts-of-dateTime(xs:gYear("2007"))</ns3:test><ns3:result><ns3:all-of><ns3:assert-count>1</ns3:assert-count><ns3:assert-type>fn:dateTime-record</ns3:assert-type><ns3:assert>$result?"year" eq 2007</ns3:assert><ns3:assert>empty($result?"month")</ns3:assert><ns3:assert>empty($result?"day")</ns3:assert><ns3:assert>empty($result?"hours")</ns3:assert><ns3:assert>empty($result?"minutes")</ns3:assert><ns3:assert>empty($result?"seconds")</ns3:assert><ns3:assert>empty($result?"timezone")</ns3:assert><ns3:assert>map:size($result) eq 7</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-gYearMonth"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is an xs:gYearMonth</ns3:description><ns3:created by="Sheila Thomson" on="2026-02-18"/><ns3:modified by="Sheila Thomson" on="2026-03-19" change="expected size reduced to 3"/><ns3:modified by="Christian Gruen" on="2026-07-01" change="PR2566"/><ns3:test>fn:parts-of-dateTime(xs:gYearMonth("2007-05Z"))</ns3:test><ns3:result><ns3:all-of><ns3:assert-count>1</ns3:assert-count><ns3:assert-type>fn:dateTime-record</ns3:assert-type><ns3:assert>$result?"year" eq 2007</ns3:assert><ns3:assert>$result?"month" eq 05</ns3:assert><ns3:assert>empty($result?"day")</ns3:assert><ns3:assert>empty($result?"hours")</ns3:assert><ns3:assert>empty($result?"minutes")</ns3:assert><ns3:assert>empty($result?"seconds")</ns3:assert><ns3:assert>$result?"timezone" eq xs:dayTimeDuration("PT0S")</ns3:assert><ns3:assert>map:size($result) eq 7</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-gMonth"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is an xs:gMonth</ns3:description><ns3:created by="Sheila Thomson" on="2026-02-18"/><ns3:modified by="Sheila Thomson" on="2026-03-19" change="expected size reduced to 1"/><ns3:modified by="Christian Gruen" on="2026-07-01" change="PR2566"/><ns3:test>fn:parts-of-dateTime(xs:gMonth("--10"))</ns3:test><ns3:result><ns3:all-of><ns3:assert-count>1</ns3:assert-count><ns3:assert-type>fn:dateTime-record</ns3:assert-type><ns3:assert>empty($result?"year")</ns3:assert><ns3:assert>$result?"month" eq 10</ns3:assert><ns3:assert>empty($result?"day")</ns3:assert><ns3:assert>empty($result?"hours")</ns3:assert><ns3:assert>empty($result?"minutes")</ns3:assert><ns3:assert>empty($result?"seconds")</ns3:assert><ns3:assert>empty($result?"timezone")</ns3:assert><ns3:assert>map:size($result) eq 7</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-gMonthDay"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is an xs:gMonthDay</ns3:description><ns3:created by="Sheila Thomson" on="2026-02-18"/><ns3:modified by="Sheila Thomson" on="2026-03-19" change="expected size reduced to 2"/><ns3:modified by="Christian Gruen" on="2026-07-01" change="PR2566"/><ns3:test>fn:parts-of-dateTime(xs:gMonthDay("--10-08"))</ns3:test><ns3:result><ns3:all-of><ns3:assert-count>1</ns3:assert-count><ns3:assert-type>fn:dateTime-record</ns3:assert-type><ns3:assert>empty($result?"year")</ns3:assert><ns3:assert>$result?"month" eq 10</ns3:assert><ns3:assert>$result?"day" eq 8</ns3:assert><ns3:assert>empty($result?"hours")</ns3:assert><ns3:assert>empty($result?"minutes")</ns3:assert><ns3:assert>empty($result?"seconds")</ns3:assert><ns3:assert>empty($result?"timezone")</ns3:assert><ns3:assert>map:size($result) eq 7</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-gDay"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is an xs:gDay</ns3:description><ns3:created by="Sheila Thomson" on="2026-02-18"/><ns3:modified by="Sheila Thomson" on="2026-03-19" change="expected size reduced to 1"/><ns3:modified by="Christian Gruen" on="2026-07-01" change="PR2566"/><ns3:test>fn:parts-of-dateTime(xs:gDay("---08"))</ns3:test><ns3:result><ns3:all-of><ns3:assert-count>1</ns3:assert-count><ns3:assert-type>fn:dateTime-record</ns3:assert-type><ns3:assert>empty($result?"year")</ns3:assert><ns3:assert>empty($result?"month")</ns3:assert><ns3:assert>$result?"day" eq 8</ns3:assert><ns3:assert>empty($result?"hours")</ns3:assert><ns3:assert>empty($result?"minutes")</ns3:assert><ns3:assert>empty($result?"seconds")</ns3:assert><ns3:assert>empty($result?"timezone")</ns3:assert><ns3:assert>map:size($result) eq 7</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-round-trip-dateTimeStamp-microsecond-precision"><ns3:description>Test round tripping using a dateTimeStamp with microsecond precision.</ns3:description><ns3:created by="Sheila Thomson" on="2026-03-26"/><ns3:test>xs:dateTime("1999-05-31T13:30:04.2678") =&gt; fn:parts-of-dateTime() =&gt; build-dateTime() =&gt; atomic-equal(xs:dateTime("1999-05-31T13:30:04.2678"))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-round-trip-dateTimeStamp-nanosecond-precision"><ns3:description>Test round tripping using a dateTimeStamp with nanosecond precision</ns3:description><ns3:created by="Michael Kay" on="2026-03-12"/><ns3:modified by="Sheila Thomson" on="2026-03-26" change="Renamed and extended description"/><ns3:test>current-dateTime() =&gt; fn:parts-of-dateTime() =&gt; build-dateTime() =&gt; atomic-equal(current-dateTime())</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-round-trip-dateTimeStamp-altered-nanosecond-precision"><ns3:description>Test round tripping and alteration using a dateTimeStamp with nanosecond precision</ns3:description><ns3:created by="Michael Kay" on="2026-03-12"/><ns3:modified by="Sheila Thomson" on="2026-03-26" change="Renamed and extended description"/><ns3:test>current-dateTime() 
			   =&gt; fn:parts-of-dateTime()
			   =&gt; map:remove("timezone")
			   =&gt; build-dateTime() 
			   =&gt; atomic-equal(current-dateTime() =&gt; adjust-dateTime-to-timezone(()))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-dayTimeDuration"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is an xs:dayTimeDuration, 
			which is not a valid datatype for the input value, even though it's the datatype used when 
			the timezone is stored in the record.</ns3:description><ns3:created by="Sheila Thomson" on="2026-02-24"/><ns3:test>fn:parts-of-dateTime(xs:dayTimeDuration("-PT5H"))</ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-empty-sequence"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is fn:empty-sequence</ns3:description><ns3:created by="Sheila Thomson" on="2026-02-18"/><ns3:test>fn:parts-of-dateTime(())</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-zero-args"><ns3:description>Evaluates fn:parts-of-dateTime when no argument is supplied</ns3:description><ns3:created by="Sheila Thomson" on="2026-02-18"/><ns3:test>fn:parts-of-dateTime()</ns3:test><ns3:result><ns3:error code="XPST0017"/></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-multiple-args"><ns3:description>Evaluates fn:parts-of-dateTime when more than one xs:date is supplied</ns3:description><ns3:created by="Sheila Thomson" on="2026-02-18"/><ns3:test>fn:parts-of-dateTime(xs:date("1941-10-08"), xs:time("13:30:04.2678"))</ns3:test><ns3:result><ns3:error code="XPST0017"/></ns3:result></ns3:test-case><ns3:test-case name="fn-parts-of-dateTime-string"><ns3:description>Evaluates fn:parts-of-dateTime when the sole argument supplied is a string, which is not one of the expected datatypes.</ns3:description><ns3:created by="Sheila Thomson" on="2026-02-24"/><ns3:test>fn:parts-of-dateTime("today")</ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case></ns3:test-set>