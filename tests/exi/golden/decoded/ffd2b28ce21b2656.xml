<?xml version="1.0" encoding="UTF-8"?><ns3:test-set xmlns:ns3="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-pad-string" covers-40="PR2784" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><ns3:description>Tests for the fn:pad-string function</ns3:description><ns3:link type="spec" document="https://qt4cg.org/specifications/xpath-functions-40/" idref="func-pad-string"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test-case name="pad-string-001"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abc", 5)</ns3:test><ns3:result><ns3:assert-eq>"abc  "</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-002"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abc", 5, ())</ns3:test><ns3:result><ns3:assert-eq>"abc  "</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-003"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abc", 5, { 'side': 'end' })</ns3:test><ns3:result><ns3:assert-eq>"abc  "</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-004"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abc", 5, { 'side': 'start' })</ns3:test><ns3:result><ns3:assert-eq>"  abc"</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-005"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abc", 5, { 'side': 'both' })</ns3:test><ns3:result><ns3:assert-eq>" abc "</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-006"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abc", 6, { 'side': 'both' })</ns3:test><ns3:result><ns3:assert-eq>" abc  "</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-007"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abc", 10, { 'padding': '-=' })</ns3:test><ns3:result><ns3:assert-eq>"abc-=-=-=-"</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-008"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abc", 5, { 'padding': 'xyz' })</ns3:test><ns3:result><ns3:assert-eq>"abcxy"</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-009"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abc", 9, { 'side': 'both', 'padding': '12' })</ns3:test><ns3:result><ns3:assert-eq>"121abc121"</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-010"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abc", 8, { 'side': 'start', 'padding': '&lt;&gt;' })</ns3:test><ns3:result><ns3:assert-eq>"&lt;&gt;&lt;&gt;&lt;abc"</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-011"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abcdef", 3)</ns3:test><ns3:result><ns3:assert-eq>"abcdef"</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-012"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abc", 0)</ns3:test><ns3:result><ns3:assert-eq>"abc"</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-013"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abc", -5)</ns3:test><ns3:result><ns3:assert-eq>"abc"</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-014"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string((), 4, { 'padding': 'ab' })</ns3:test><ns3:result><ns3:assert-eq>"abab"</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-015"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string(42, 6, { 'padding': '0', 'side': 'start' })</ns3:test><ns3:result><ns3:assert-eq>"000042"</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-016"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string(xs:double(1.5), 6, { 'padding': '0' })</ns3:test><ns3:result><ns3:assert-eq>"1.5000"</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-017"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string(true(), 6, { 'padding': '.' })</ns3:test><ns3:result><ns3:assert-eq>"true.."</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-018"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string(fn:parse-xml("&lt;a&gt;x&lt;/a&gt;")/a, 4, { 'padding': '.' })</ns3:test><ns3:result><ns3:assert-eq>"x..."</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-019"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:string-to-codepoints(fn:pad-string(fn:char(128512), 3, { 'padding': '.' }))</ns3:test><ns3:result><ns3:assert-deep-eq>128512, 46, 46</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-020"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:string-to-codepoints(fn:pad-string("ab", 4, { 'padding': fn:char(128512) }))</ns3:test><ns3:result><ns3:assert-deep-eq>97, 98, 128512, 128512</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="pad-string-021"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abc", 6, { 'padding': '' })</ns3:test><ns3:result><ns3:error code="FORG0001"/></ns3:result></ns3:test-case><ns3:test-case name="pad-string-022"><ns3:description>Evaluation of the pad-string function.</ns3:description><ns3:created by="Christian Gruen" on="2026-07-14"/><ns3:test>fn:pad-string("abc", 6, { 'side': 'middle' })</ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case></ns3:test-set>