scription><created by="Michael Kay" on="2012-11-07"/><dependencies><spec value="XSLT20+"/></dependencies><test><stylesheet file="backwards-006.xsl"/><initial-template name="main"/></test><result><assert-xml>&lt;out&gt;&lt;one&gt;1&lt;/one&gt;&lt;two&gt;1 2 3 4 5&lt;/two&gt;&lt;/out&gt;</assert-xml></result></test-case><test-case name="backwards-007"><description>Mixing versions in one stylesheet module, nested override</description><created by="Michael Kay" on="2012-11-07"/><dependencies><spec value="XSLT20+"/></dependencies><test><stylesheet file="backwards-007.xsl"/><initial-template name="main"/></test><result><assert-xml>&lt;out&gt;&lt;one&gt;1&lt;/one&gt;&lt;two&gt;1 2 3 4 5&lt;/two&gt;&lt;/out&gt;</assert-xml></result></test-case><test-case name="backwards-008"><description>Mixing versions in two stylesheet modules</description><created by="Michael Kay" on="2012-11-07"/><dependencies><spec value="XSLT20+"/></dependencies><test><stylesheet file="backwards-008.xsl"/><stylesheet file="backwards-001.xsl" role="secondary"/><initial-template name="two"/></test><result><assert-xml>&lt;out-two&gt;&lt;out&gt;1&lt;/out&gt;&lt;two&gt;1 2 3 4 5&lt;/two&gt;&lt;/out-two&gt;</assert-xml></result></test-case><test-case name="backwards-009"><description>xsl:value-of with separator, version is irrelevant</description><created by="Michael Kay" on="2012-11-07"/><dependencies><spec value="XSLT20+"/></dependencies><test><stylesheet file="backwards-009.xsl"/><initial-template name="main"/></test><result><assert-xml>&lt;out&gt;&lt;one&gt;1,2,3,4,5&lt;/one&gt;&lt;two&gt;1,2,3,4,5&lt;/two&gt;&lt;/out&gt;</assert-xml></result></test-case><test-case name="backwards-010"><description>effect of BC on AVTs</description><created by="Michael Kay" on="2012-11-07"/><dependencies><spec value="XSLT20+"/></dependencies><test><stylesheet file="backwards-010.xsl"/><initial-template name="main"/></test><result><assert-xml>&lt;out&gt;&lt;one select="1"/&gt;&lt;two select="1 2 3 4 5"/&gt;&lt;/out&gt;</