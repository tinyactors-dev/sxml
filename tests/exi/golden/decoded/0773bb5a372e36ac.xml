<?xml version="1.0" encoding="UTF-8"?><ns3:test-set xmlns:ns3="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-civil-timezone" covers-40="PR1545" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><ns3:description>Tests for the fn:civil-timezone function</ns3:description><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test-case name="civil-timezone-001"><ns3:description>Civil timezone here and now</ns3:description><ns3:created by="Michael Kay" on="2024-11-05"/><ns3:test>civil-timezone(current-dateTime())</ns3:test><ns3:result><ns3:assert-type>xs:dayTimeDuration</ns3:assert-type></ns3:result></ns3:test-case><ns3:test-case name="civil-timezone-002"><ns3:description>Difference between civil time now and in six months</ns3:description><ns3:created by="Michael Kay" on="2024-11-05"/><ns3:test>civil-timezone(current-dateTime()) - civil-timezone(current-dateTime() + xs:dayTimeDuration("P180D"))</ns3:test><ns3:result><ns3:any-of><ns3:assert-eq>xs:dayTimeDuration("PT1H")</ns3:assert-eq><ns3:assert-eq>xs:dayTimeDuration("-PT1H")</ns3:assert-eq><ns3:assert-eq>xs:dayTimeDuration("PT0H")</ns3:assert-eq></ns3:any-of></ns3:result></ns3:test-case><ns3:test-case name="civil-timezone-003"><ns3:description>Paris time in November</ns3:description><ns3:created by="Michael Kay" on="2024-11-05"/><ns3:test>civil-timezone(xs:dateTime("2024-11-05T12:00:00Z"), "Europe/Paris")</ns3:test><ns3:result><ns3:assert-eq>xs:dayTimeDuration("PT1H")</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="civil-timezone-004"><ns3:description>Paris time in May</ns3:description><ns3:created by="Michael Kay" on="2024-11-05"/><ns3:test>civil-timezone(xs:dateTime("2024-05-05T12:00:00Z"), "Europe/Paris")</ns3:test><ns3:result><ns3:assert-eq>xs:dayTimeDuration("PT2H")</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="civil-timezone-005"><ns3:description>India time, all year round</ns3:description><ns3:created by="Michael Kay" on="2024-11-05"/><ns3:test>civil-timezone(current-dateTime(), "Asia/Kolkata")</ns3:test><ns3:result><ns3:assert-eq>xs:dayTimeDuration("PT5H30M")</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="civil-timezone-006"><ns3:description>Peru time, all year round</ns3:description><ns3:created by="Michael Kay" on="2024-11-05"/><ns3:test>civil-timezone(current-dateTime(), "America/Lima")</ns3:test><ns3:result><ns3:assert-eq>xs:dayTimeDuration("-PT5H")</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="civil-timezone-007"><ns3:description>Unknown timezone</ns3:description><ns3:created by="Michael Kay" on="2024-11-05"/><ns3:test>civil-timezone(current-dateTime(), "North/Pole")</ns3:test><ns3:result><ns3:error code="FODT0004"/></ns3:result></ns3:test-case><ns3:test-case name="civil-timezone-008"><ns3:description>Empty second arg</ns3:description><ns3:created by="Michael Kay" on="2024-11-05"/><ns3:test>civil-timezone(current-dateTime(), ())</ns3:test><ns3:result><ns3:assert-type>xs:dayTimeDuration</ns3:assert-type></ns3:result></ns3:test-case><ns3:test-case name="civil-timezone-009"><ns3:description>Supplied date/time has no timezone</ns3:description><ns3:created by="Michael Kay" on="2024-11-05"/><ns3:test>civil-timezone(xs:dateTime("2024-01-01T12:00:00"), "Asia/Kolkata")</ns3:test><ns3:result><ns3:assert-eq>xs:dayTimeDuration("PT5H30M")</ns3:assert-eq></ns3:result></ns3:test-case></ns3:test-set>