es><ns3:test><ns3:stylesheet file="backwards-024.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;7&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-025"><ns3:description>effect of BC on arithmetic expressions</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-025.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;2&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-026"><ns3:description>effect of BC on arithmetic expressions</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-026.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;21&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-027"><ns3:description>effect of BC on arithmetic expressions</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-027.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;true&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-028"><ns3:description>effect of BC on general comparisons</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-028.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;true&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-029"><ns3:description>effect of BC on general comparisons</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-029.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;true&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-030"><ns3:description>effect of BC on general comparisons</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-030.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;true&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-031"><ns3:description>effect of BC on general comparisons</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-031.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;true&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-032"><ns3:description>effect of BC on general comparisons</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-032.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;true&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-033"><ns3:description>effect of BC on general comparisons</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-033.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;true&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-034"><ns3:description>effect of BC on errors in logical expressions</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-034.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;false&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-035"><ns3:description>effect of BC on errors in logical expressions</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-035.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;true&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-036"><ns3:description>Backwards compatibility mode with simplified stylesheet</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:environment ref="backwards006"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-036.xsl"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;1&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-037"><ns3:description>Backwards compatibility mode with simplified stylesheet,
         version=+1.99999</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:environment ref="backwards006"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-037.xsl"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;1&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-038"><ns3:description>effect of BC on xsl:key and key() function</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:environment ref="backwards006"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-038.xsl"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;&lt;k&gt;&lt;item&gt;1&lt;/item&gt;&lt;/k&gt;&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-039"><ns3:description>effect of BC on xsl:key and key() function; two key definitions, same name, one
         in 1.0 mode one in 2.0 mode.</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:modified by="Michael Kay" on="2012-11-27" change="See bug 20102"/><ns3:environment ref="backwards006"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-039.xsl"/><ns3:stylesheet file="backwards-038.xsl" role="secondary"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;&lt;k&gt;&lt;item&gt;1.00&lt;/item&gt;&lt;/k&gt;&lt;k&gt;&lt;item&gt;1&lt;/item&gt;&lt;/k&gt;&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-040"><ns3:description>effect of BC on parameter passing in built-in templates</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:environment ref="backwards006"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-040.xsl"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;&lt;item-found param="3"&gt;&lt;item&gt;1.00&lt;/item&gt;&lt;/item-found&gt;&lt;item-found param="3"
            &gt;&lt;item&gt;2.00&lt;/item&gt;&lt;/item-found&gt;&lt;item-found param="3"&gt;&lt;item&gt;1&lt;/item&gt;&lt;/item-found&gt;&lt;item-found param="3"
            &gt;&lt;item&gt;2&lt;/item&gt;&lt;/item-found&gt;&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-041"><ns3:description>effect of BC on function call argument conversions</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:environment ref="backwards006"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-041.xsl"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;true&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-042"><ns3:description>In range expressions, (M to N), standard function conversion rules apply, which
