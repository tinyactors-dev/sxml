         See spec bugzilla entry 7424.</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:environment ref="backwards006"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-042.xsl"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;1,2,3&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-043"><ns3:description>effect of BC on xsl:key and key() function; two key definitions, same name, one
         in 1.0 mode one in 2.0 mode.</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:environment ref="backwards072"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-043.xsl"/><ns3:stylesheet file="backwards-043a.xsl" role="secondary"/><ns3:stylesheet file="backwards-043b.xsl" role="secondary"/></ns3:test><ns3:result><ns3:assert-xml>&lt;result&gt;&lt;one marker="a"/&gt;&lt;two marker="b"/&gt;&lt;/result&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-044"><ns3:description>Arithmetic in BC mode (a test that fails in Saxon 9.1)</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:environment ref="backwards073"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-044.xsl"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;3&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-045"><ns3:description>Fine-grained changes in xsl:version</ns3:description><ns3:created by="Michael Kay" on="2014-11-26"/><ns3:dependencies><ns3:spec value="XSLT30+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-045.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:all-of><ns3:assert>/out/a1 eq 'true'</ns3:assert><ns3:assert>/out/a2 eq 'false'</ns3:assert><ns3:assert>/out/b1 eq 'true'</ns3:assert><ns3:assert>/out/b2 eq 'false'</ns3:assert><ns3:assert>/out/c1 eq '1'</ns3:assert><ns3:assert>/out/c2 eq '1 2 3'</ns3:assert><ns3:assert>/out/d1 eq 'false'</ns3:assert><ns3:assert>/out/d2 eq 'failed'</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="backwards-046"><ns3:description>Effect of BC mode when required type is xs:string?</ns3:description><ns3:created by="Michael Kay" on="2024-05-14"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-046.xsl"/></ns3:test><ns3:result><ns3