<?xml version="1.0" encoding="UTF-8"?><ns3:test-set xmlns:ns3="http://www.w3.org/2012/10/xslt-test-catalog" name="backwards" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><ns3:description>Tests backwards compatibility with XSLT 1.0</ns3:description><ns3:environment name="backwards006"><ns3:source role="."><ns3:content>&lt;data&gt;&lt;item&gt;1.00&lt;/item&gt;&lt;item&gt;2.00&lt;/item&gt;&lt;item&gt;1&lt;/item&gt;&lt;item&gt;2&lt;/item&gt;&lt;/data&gt;</ns3:content></ns3:source></ns3:environment><ns3:environment name="backwards072"><ns3:source role="."><ns3:content>&lt;root&gt;
     &lt;one marker="a"/&gt;
     &lt;two marker="b"/&gt;
     &lt;three marker="c"/&gt;
&lt;/root&gt;</ns3:content></ns3:source></ns3:environment><ns3:environment name="backwards073"><ns3:source role="."><ns3:content>&lt;apply&gt;
  &lt;partialdiff/&gt;
  &lt;bvar&gt;
    &lt;ci&gt;x&lt;/ci&gt; 
    &lt;degree&gt;
      &lt;cn&gt;2&lt;/cn&gt; 
    &lt;/degree&gt;  
  &lt;/bvar&gt; 
  &lt;bvar&gt;
    &lt;ci&gt;y&lt;/ci&gt; 
  &lt;/bvar&gt; 
&lt;/apply&gt;</ns3:content></ns3:source></ns3:environment><ns3:dependencies><ns3:feature value="backwards_compatibility"/></ns3:dependencies><ns3:test-case name="backwards-001"><ns3:description>Basic test of backwards compatibility mode</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-001.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;1&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-002"><ns3:description>Backwards compatibility mode with version=1.9</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-002.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;1&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-003"><ns3:description>Backwards compatibility mode with version=001</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-003.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;1&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-004"><ns3:description>Backwards compatibility mode with version=+0.5</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-004.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;1&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-005"><ns3:description>Backwards compatibility mode with version=-29</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-005.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;1&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-006"><ns3:description>Mixing versions in one stylesheet module</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-006.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;&lt;one&gt;1&lt;/one&gt;&lt;two&gt;1 2 3 4 5&lt;/two&gt;&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-007"><ns3:description>Mixing versions in one stylesheet module, nested override</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-007.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;&lt;one&gt;1&lt;/one&gt;&lt;two&gt;1 2 3 4 5&lt;/two&gt;&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-008"><ns3:description>Mixing versions in two stylesheet modules</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-008.xsl"/><ns3:stylesheet file="backwards-001.xsl" role="secondary"/><ns3:initial-template name="two"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out-two&gt;&lt;out&gt;1&lt;/out&gt;&lt;two&gt;1 2 3 4 5&lt;/two&gt;&lt;/out-two&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-009"><ns3:description>xsl:value-of with separator, version is irrelevant</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-009.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;&lt;one&gt;1,2,3,4,5&lt;/one&gt;&lt;two&gt;1,2,3,4,5&lt;/two&gt;&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-010"><ns3:description>effect of BC on AVTs</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-010.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;&lt;one select="1"/&gt;&lt;two select="1 2 3 4 5"/&gt;&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-011"><ns3:description>effect of BC on xsl:number</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-011.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;&lt;one&gt;1&lt;/one&gt;&lt;two&gt;1.2.3.4.5&lt;/two&gt;&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-012"><ns3:description>effect of BC on xsl:sort</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-012.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;5 4 3 2 1&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-013"><ns3:description>effect of BC on xsl:call-template</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-013.xsl"/><ns3:stylesheet file="backwards-001.xsl" role="secondary"/><ns3:initial-template name="two"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;&lt;out&gt;1&lt;/out&gt;&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-014"><ns3:description>effect of BC on unresolved function calls</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-014.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out/&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-015"><ns3:description>effect of BC on xsl:number</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-015.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;NaN&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-016"><ns3:description>effect of BC on xsl:number</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:dependencies><ns3:spec value="XSLT20+"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-016.xsl"/><ns3:initial-template name="main"/></ns3:test><ns3:result><ns3:assert-xml>&lt;out&gt;NaN&lt;/out&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="backwards-017"><ns3:description>effect of BC on default output method</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:modified by="Michael Kay" on="2022-06-15" change="This should be a serialization test. See GitHub issue #9."/><ns3:dependencies><ns3:spec value="XSLT10+"/><ns3:feature value="serialization"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-017.xsl"/><ns3:initial-template name="main"/><ns3:output serialize="yes"/></ns3:test><ns3:result><ns3:serialization-matches>href="file:///My Documents/page.html"</ns3:serialization-matches></ns3:result></ns3:test-case><ns3:test-case name="backwards-018"><ns3:description>effect of BC on default output method</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:modified by="John Lumley" on="2014-09-02" change="Declared serialization requirement"/><ns3:modified by="Sheila Thomson" on="2026-07-28" change="Allow HTML5 meta/@charset instead of meta/@http-equiv"/><ns3:dependencies><ns3:spec value="XSLT20+"/><ns3:feature value="serialization"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-018.xsl"/><ns3:initial-template name="main"/><ns3:output serialize="yes"/></ns3:test><ns3:result><ns3:all-of><ns3:any-of><ns3:serialization-matches>meta http-equiv</ns3:serialization-matches><ns3:serialization-matches>meta charset</ns3:serialization-matches></ns3:any-of></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="backwards-019"><ns3:description>effect of BC on default output method (implicit result document)</ns3:description><ns3:created by="Michael Kay" on="2012-11-07"/><ns3:modified by="Michael Kay" on="2014-04-28" change="correct expected results"/><ns3:modified by="John Lumley" on="2014-09-02" change="Declared serialization requirement"/><ns3:modified by="Michael Kay" on="2022-06-15" change="Change expected result. See GitHub issue #9"/><ns3:dependencies><ns3:spec value="XSLT20+"/><ns3:feature value="serialization"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-019.xsl"/><ns3:initial-template name="main"/><ns3:output serialize="yes"/></ns3:test><ns3:result><ns3:serialization-matches>file:///My Døcuments/page.html</ns3:serialization-matches></ns3:result></ns3:test-case><ns3:test-case name="backwards-019b"><ns3:description>effect of BC on default output method (explicit result document)</ns3:description><ns3:created by="Michael Kay" on="2022-06-15"/><ns3:dependencies><ns3:spec value="XSLT20+"/><ns3:feature value="serialization"/></ns3:dependencies><ns3:test><ns3:stylesheet file="backwards-019b.xsl"/><ns3:initial-template name="main"/><ns3:output serialize="yes"/></ns3:test><ns3:result><ns3:serialization-matches>file:///My D%C