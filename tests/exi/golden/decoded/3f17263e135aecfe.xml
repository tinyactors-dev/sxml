<?xml version="1.0" encoding="UTF-8"?><ns3:test-set xmlns:ns3="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-replicate" covers-40="fn-replicate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><ns3:description>Tests for the fn:replicate function (4.0 proposal)</ns3:description><ns3:link type="spec" document="http://www.w3.org/TR/xpath-functions-11/" idref="func-replicate"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test-case name="replicate-001"><ns3:description>Empty sequence</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>replicate((), 0)</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="replicate-002"><ns3:description>Empty sequence</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>replicate((), 1)</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="replicate-003"><ns3:description>Empty sequence</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>replicate((1 to 10), 0)</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="replicate-004"><ns3:description>Single string</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>replicate('a', 1)</ns3:test><ns3:result><ns3:assert-string-value>a</ns3:assert-string-value></ns3:result></ns3:test-case><ns3:test-case name="replicate-005"><ns3:description>Single string</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>replicate('a', 2)</ns3:test><ns3:result><ns3:assert-deep-eq>'a', 'a'</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="replicate-006"><ns3:description>Multiple strings</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>replicate(('a', 'b'), 1)</ns3:test><ns3:result><ns3:assert-deep-eq>'a', 'b'</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="replicate-007"><ns3:description>Multiple strings</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>replicate(('a', 'b'), 2)</ns3:test><ns3:result><ns3:assert-deep-eq>'a', 'b', 'a', 'b'</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="replicate-008"><ns3:description>Count resulting items</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>count(replicate('a', 1984))</ns3:test><ns3:result><ns3:assert-eq>1984</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="replicate-009"><ns3:description>Count resulting items</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>count(replicate(replicate('a', 1984), 1984))</ns3:test><ns3:result><ns3:assert-eq>3936256</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="replicate-010"><ns3:description>Positional access to result</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>replicate(23432, 10000)[1]</ns3:test><ns3:result><ns3:assert-eq>23432</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="replicate-011"><ns3:description>Positional access to result</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>replicate(23432, 10000)[last()]</ns3:test><ns3:result><ns3:assert-eq>23432</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="replicate-012"><ns3:description>Positional access to result</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>replicate(34342, 11111)[5555]</ns3:test><ns3:result><ns3:assert-eq>34342</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="replicate-013"><ns3:description>Positional access to result</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>replicate(('X', 'Y'), 100)[99]</ns3:test><ns3:result><ns3:assert-string-value>X</ns3:assert-string-value></ns3:result></ns3:test-case><ns3:test-case name="replicate-014"><ns3:description>Positional access to result</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test>for $i in 1 to 2 return replicate(3, $i)</ns3:test><ns3:result><ns3:assert-deep-eq>3, 3, 3</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="replicate-015"><ns3:description>Node argument</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test> replicate(&lt;_/&gt;, 2) ! name() </ns3:test><ns3:result><ns3:assert-deep-eq>'_', '_'</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="replicate-016"><ns3:description>Node argument</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test> sum((1 to 10) ! replicate(&lt;_&gt;{ . }&lt;/_&gt;, 1)) </ns3:test><ns3:result><ns3:assert-eq>55</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="replicate-017"><ns3:description>Node argument</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test> sum((1 to 10) ! replicate(1, &lt;_&gt;{ . }&lt;/_&gt;)) </ns3:test><ns3:result><ns3:assert-eq>55</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="replicate-018"><ns3:description>Node arguments</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test> sum((1 to 10) ! replicate(&lt;_&gt;{ . }&lt;/_&gt;, &lt;_&gt;{ . }&lt;/_&gt;)) </ns3:test><ns3:result><ns3:assert-eq>385</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="replicate-019"><ns3:description>Arrays</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test> replicate([ 1, 2 ], 3)?* </ns3:test><ns3:result><ns3:assert-deep-eq>1, 2, 1, 2, 1, 2</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="replicate-020"><ns3:description>Function items</ns3:description><ns3:created by="Christian Gruen" on="2022-08-08"/><ns3:test> replicate(false#0, 2)[.()] </ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="replicate-901"><ns3:description>Error condition: second argument is negative</ns3:description><ns3:created by="Michael Kay" on="2022-08-11"/><ns3:test>replicate('a', -3)</ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case></ns3:test-set>