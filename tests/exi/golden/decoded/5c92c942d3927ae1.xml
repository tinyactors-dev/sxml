<?xml version="1.0" encoding="UTF-8"?><ns3:test-set xmlns:ns3="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-jtree" covers-40="PR2031" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><ns3:description>Tests for the fn:jtree() function</ns3:description><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test-case name="fn-jtree-001"><ns3:description> JNode applied to an array </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree([1,2,3]) =&gt; fn:jvalue()</ns3:test><ns3:result><ns3:all-of><ns3:assert-type>array(xs:integer)</ns3:assert-type><ns3:assert-deep-eq>[1,2,3]</ns3:assert-deep-eq></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-002"><ns3:description> JNode applied to a map </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree({"a": 1, "b": 2}) =&gt; fn:jvalue()</ns3:test><ns3:result><ns3:all-of><ns3:assert-type>map(xs:string, xs:integer)</ns3:assert-type><ns3:assert-deep-eq>{"a": 1, "b": 2}</ns3:assert-deep-eq></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-003"><ns3:description> JNode applied to empty sequence </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:modified by="Christian Gruen" on="2026-08-26" change="PR2840"/><ns3:test>fn:jtree(()) =&gt; fn:jvalue()</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-004"><ns3:description> JNode applied to a JNode - the JNode is wrapped a second time </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:modified by="Christian Gruen" on="2026-08-26" change="PR2840"/><ns3:test>fn:jtree(fn:jtree([1,2,3])) =&gt; fn:jvalue() =&gt; fn:jvalue()</ns3:test><ns3:result><ns3:all-of><ns3:assert-type>array(xs:integer)</ns3:assert-type><ns3:assert-deep-eq>[1,2,3]</ns3:assert-deep-eq></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-005"><ns3:description> JNode applied to an atomic value </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:modified by="Christian Gruen" on="2026-08-26" change="PR2840"/><ns3:test>fn:jtree(22) =&gt; fn:jvalue()</ns3:test><ns3:result><ns3:assert-eq>22</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-006"><ns3:description> JNode applied to an array - type of result</ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:modified by="Christian Gruen" on="2026-02-10" change="syntax updated"/><ns3:test>fn:jtree([1,2,3]) instance of jnode(*, array(xs:integer))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-007"><ns3:description> JNode applied to a map - type of result</ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:modified by="Christian Gruen" on="2026-02-10" change="syntax updated"/><ns3:test>fn:jtree({"a":1, "b": 2}) instance of jnode(*, map(xs:string, xs:integer))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-008"><ns3:description> JNode applied to an array - type of result</ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree([1,2,3]) instance of jnode()</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-009"><ns3:description> JNode applied to a map - type of result</ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree({"a":1, "b": 2}) instance of jnode()</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-010"><ns3:description> JNode coerced to atomic value</ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree([22]) gt 21</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-011"><ns3:description> JNode coerced to atomic value</ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree([22]) + 21</ns3:test><ns3:result><ns3:assert-eq>43</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-012"><ns3:description> JNode coerced to array</ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree([22, 23]) =&gt; array:size()</ns3:test><ns3:result><ns3:assert-eq>2</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-013"><ns3:description> JNode coerced to map</ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree({"a":1, "b":2}) =&gt; map:size()</ns3:test><ns3:result><ns3:assert-eq>2</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-014"><ns3:description> Parent of root JNode is absent </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree({}) / parent::*</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-015"><ns3:description> Selector of root JNode is absent </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree({"a":1, "b":2}) =&gt; fn:jkey()</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-017"><ns3:description> Array with one child: selector </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree([12]) / child::* =&gt; fn:jkey()</ns3:test><ns3:result><ns3:assert-eq>1</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-019"><ns3:description> Array with one child: parent </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree([12]) / child::* / parent::* =&gt; fn:jvalue()</ns3:test><ns3:result><ns3:assert-deep-eq>[12]</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-020"><ns3:description> Array with one child: value </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree([12]) / child::* =&gt; fn:jvalue()</ns3:test><ns3:result><ns3:assert-deep-eq>12</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-021"><ns3:description> Array with one child: implicit atomization </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree([12]) / child::* + 2</ns3:test><ns3:result><ns3:assert-deep-eq>14</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-022"><ns3:description> Map with one child: selector </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree({"a":1}) / child::* =&gt; fn:jkey()</ns3:test><ns3:result><ns3:assert-eq>"a"</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-024"><ns3:description> Map with one child: parent </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree({"a":1}) / child::* / parent::* =&gt; fn:jvalue()</ns3:test><ns3:result><ns3:assert-deep-eq>{"a":1}</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-025"><ns3:description> Map with one child: value </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree({"a":13}) / child::* =&gt; fn:jvalue()</ns3:test><ns3:result><ns3:assert-deep-eq>13</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-026"><ns3:description> Map with one child: implicit atomization </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree({"a":13}) / child::* + 2</ns3:test><ns3:result><ns3:assert-deep-eq>15</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-027" covers-40="PR2840"><ns3:description> Apply to atomic value</ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree(42) =&gt; jvalue()</ns3:test><ns3:result><ns3:assert-eq>42</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-028" covers-40="PR2840"><ns3:description> Apply to function item </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>fn:jtree(fn:abs#1) =&gt; jvalue() =&gt; apply([-42])</ns3:test><ns3:result><ns3:assert-eq>42</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-029" covers-40="PR2840"><ns3:description> Apply to XNode </ns3:description><ns3:created by="Michael Kay" on="2025-06-16"/><ns3:test>(fn:jtree(parse-xml("&lt;a id='42'/&gt;")) =&gt; jvalue()) -&gt; //@id </ns3:test><ns3:result><ns3:assert-eq>"42"</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-030" covers-40="PR2840"><ns3:description>Evaluation of fn:jtree with arbitrary input.</ns3:description><ns3:created by="Christian Gruen" on="2026-10-01"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test>jtree(1) ! (jvalue(.), . instance of jnode())</ns3:test><ns3:result><ns3:assert-deep-eq>1, true()</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-031" covers-40="PR2840"><ns3:description>Evaluation of fn:jtree with arbitrary input.</ns3:description><ns3:created by="Christian Gruen" on="2026-10-01"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test>jtree(()) ! (empty(jvalue(.)), empty(jkey(.)))</ns3:test><ns3:result><ns3:assert-deep-eq>true(), true()</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-032" covers-40="PR2840"><ns3:description>Evaluation of fn:jtree with arbitrary input.</ns3:description><ns3:created by="Christian Gruen" on="2026-10-01"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test>jtree((1, 'a'))/* ! (jkey(.), jvalue(.))</ns3:test><ns3:result><ns3:assert-deep-eq>1, 1, 2, "a"</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-jtree-033" covers-40="PR2840"><ns3:description>Evaluation of fn:jtree with arbitrary input.</ns3:description><ns3:created by="Christian Gruen" on="2026-10-01"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test>jtree(parse-xml('&lt;a/&gt;')/a) ! (jvalue(.) instance of element(a))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case></ns3:test-set>