<?xml version="1.0" encoding="UTF-8"?><ns3:test-set xmlns:ns3="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-highest" covers-40="fn-highest" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><ns3:description>Tests for the fn:highest function (4.0 proposal)</ns3:description><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test-case name="highest-001"><ns3:description>test highest() - Saxon 9.2 version using higher-order functions</ns3:description><ns3:created by="Michael Kay" on="2014-04-13"/><ns3:test>
         highest(doc('highest/highest-001.xml')/*/*, (), function($item as element()){xs:decimal($item)})
      </ns3:test><ns3:result><ns3:all-of><ns3:assert>$result[1][@id="5"]='123.60'</ns3:assert><ns3:assert>$result[2][@id="8"]='123.6'</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="highest-002"><ns3:description>test highest() on an empty sequence - Saxon 9.2 version using higher-order functions</ns3:description><ns3:created by="Michael Kay" on="2014-04-13"/><ns3:test>
         highest(doc('highest/highest-001.xml')/*/*[@non-existent], (), function($item as element()){xs:decimal($item)})
      </ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="highest-003"><ns3:description>test highest() using collations - Saxon 9.2 version using higher-order functions</ns3:description><ns3:created by="Michael Kay" on="2014-04-13"/><ns3:modified by="Christian Gruen" on="2024-03-18" change="collation declaration added"/><ns3:dependency type="spec" value="XQ31+"/><ns3:test>
         declare default collation 'http://www.w3.org/2005/xpath-functions/collation/html-ascii-case-insensitive';
         highest(doc('highest/highest-003.xml')/*/*, (), function($item as element()){xs:string($item)})
      </ns3:test><ns3:result><ns3:all-of><ns3:assert>$result[1][@id="5"]='katy'</ns3:assert><ns3:assert>$result[2][@id="7"]='Katy'</ns3:assert><ns3:assert>$result[3][@id="8"]='KATY'</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="highest-004"><ns3:description>test highest() with a default collation</ns3:description><ns3:created by="Michael Kay" on="2014-04-13"/><ns3:modified by="Gunther Rademacher" on="2025-02-27" change="Removed XP40+ dependency"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>
         declare default collation 'http://www.w3.org/2005/xpath-functions/collation/html-ascii-case-insensitive';
         highest(doc('highest/highest-003.xml')/*/*, (), string#1)        
      </ns3:test><ns3:result><ns3:all-of><ns3:assert>$result[1][@id="5"]='katy'</ns3:assert><ns3:assert>$result[2][@id="7"]='Katy'</ns3:assert><ns3:assert>$result[3][@id="8"]='KATY'</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="highest-005"><ns3:description>test highest() : second argument is a system function</ns3:description><ns3:created by="Michael Kay" on="2014-04-13"/><ns3:test>
         highest(doc('highest/highest-005.xml')/*/*, (), round#1)   
      </ns3:test><ns3:result><ns3:all-of><ns3:assert>$result[1][@id="1"]='123.5'</ns3:assert><ns3:assert>$result[2][@id="5"]='123.60'</ns3:assert><ns3:assert>$result[3][@id="7"]='123.5'</ns3:assert><ns3:assert>$result[4][@id="8"]='123.6'</ns3:assert></ns3:all-of></ns3:result></ns3:test-case><ns3:test-case name="highest-100"><ns3:description>Empty sequence</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest(())</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="highest-101"><ns3:description>Filter yielding single string</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest(('a', 'b', 'c', 'd', 'e', 'f')[. = 'f'])</ns3:test><ns3:result><ns3:assert-string-value>f</ns3:assert-string-value></ns3:result></ns3:test-case><ns3:test-case name="highest-102"><ns3:description>Filter yielding empty sequence</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest(('a', 'b', 'c', 'd', 'e', 'f')[. = 'g'])</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="highest-103"><ns3:description>Single string</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest('x')</ns3:test><ns3:result><ns3:assert-string-value>x</ns3:assert-string-value></ns3:result></ns3:test-case><ns3:test-case name="highest-104"><ns3:description>Doubles</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest((1e0, 2e0))</ns3:test><ns3:result><ns3:assert-eq>2</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-105"><ns3:description>Integers</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest((8 to 11))</ns3:test><ns3:result><ns3:assert-eq>11</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-106"><ns3:description>Reversed integers</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest(reverse(8 to 11))</ns3:test><ns3:result><ns3:assert-eq>11</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-107"><ns3:description>Integers compared as strings</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest((8 to 11), (), string#1)</ns3:test><ns3:result><ns3:assert-eq>9</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-108"><ns3:description>Reversed integers compared as strings</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest(reverse(8 to 11), (), string#1)</ns3:test><ns3:result><ns3:assert-eq>9</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-109"><ns3:description>Integers ignored by the comparator</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest((3, 2, 1), (), function($k) { true() })</ns3:test><ns3:result><ns3:assert-deep-eq>3, 2, 1</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-110"><ns3:description>Integers compared by their string length</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest((8 to 11), (), function($k) { string-length(string($k)) })</ns3:test><ns3:result><ns3:assert-deep-eq>10, 11</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-111"><ns3:description>Reversed integers compared by their string length</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest(reverse(8 to 11), (), function($k) { string-length(string($k)) })</ns3:test><ns3:result><ns3:assert-deep-eq>11, 10</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-112"><ns3:description>Elements with numeric attribute comparison</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>fn:highest((&lt;a _='1'/&gt;, &lt;b _='2'/&gt;), (), function($k) { $k/@* }) ! name()</ns3:test><ns3:result><ns3:assert-string-value>b</ns3:assert-string-value></ns3:result></ns3:test-case><ns3:test-case name="highest-113"><ns3:description>Element with numeric attribute comparison</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>fn:highest(&lt;_ _='1'/&gt;, (), function($a) { $a/@* })</ns3:test><ns3:result><ns3:assert-xml>&lt;_ _="1"/&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="highest-114"><ns3:description>Elements with numeric attribute comparison</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>fn:highest((&lt;_ _='9'/&gt;, &lt;_ _='10'/&gt;), (), function($a) { $a/@* })</ns3:test><ns3:result><ns3:assert-xml>&lt;_ _="10"/&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="highest-115"><ns3:description>Element with attribute string comparison</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>fn:highest((&lt;_ _='9'/&gt;, &lt;_ _='10'/&gt;), (), function($a) { string($a/@*) })</ns3:test><ns3:result><ns3:assert-xml>&lt;_ _="9"/&gt;</ns3:assert-xml></ns3:result></ns3:test-case><ns3:test-case name="highest-116"><ns3:description>Replicated argument</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest(replicate('a', 2))</ns3:test><ns3:result><ns3:assert-deep-eq>'a', 'a'</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-117"><ns3:description>Replicated argument</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest(replicate(5, 2))</ns3:test><ns3:result><ns3:assert-deep-eq>5, 5</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-118"><ns3:description>Reversed argument</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest(reverse( (1 to 6)[. &gt; 3] ))</ns3:test><ns3:result><ns3:assert-eq>6</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-119"><ns3:description>Arguments of different types</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:highest((1, 'x'))</ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case><ns3:test-case name="highest-120" covers-40="PR2256"><ns3:description>Comparison of dates</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:modified by="Christian Gruen" on="2025-12-15"/><ns3:test>fn:highest((xs:gYear('9998'), xs:gYear('9999')))</ns3:test><ns3:result><ns3:assert-eq>xs:gYear('9999')</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-121"><ns3:description>Argument that cannot be compared</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:modified by="Michael Kay" on="2023-02-02" change="with a singleton sequence, a processor could avoid evaluating the sort key"/><ns3:test>fn:highest((true#0, false#0))</ns3:test><ns3:result><ns3:error code="FOTY0013"/></ns3:result></ns3:test-case><ns3:test-case name="highest-122"><ns3:description>Untyped data that cannot be converted to xs:double</ns3:description><ns3:created by="Christian Gruen" on="2022-11-24"/><ns3:test>fn:highest((xs:untypedAtomic('1'), xs:untypedAtomic('')))</ns3:test><ns3:result><ns3:error code="FORG0001"/></ns3:result></ns3:test-case><ns3:test-case name="highest-123"><ns3:description>Untyped data that cannot be converted to xs:double</ns3:description><ns3:created by="Christian Gruen" on="2022-11-24"/><ns3:test>fn:highest((xs:untypedAtomic(''), xs:untypedAtomic('1')))</ns3:test><ns3:result><ns3:error code="FORG0001"/></ns3:result></ns3:test-case><ns3:test-case name="highest-124"><ns3:description>Untyped data that cannot be converted to xs:double</ns3:description><ns3:created by="Christian Gruen" on="2022-11-24"/><ns3:test>fn:highest(replicate(xs:untypedAtomic(''), 2))</ns3:test><ns3:result><ns3:error code="FORG0001"/></ns3:result></ns3:test-case><ns3:test-case name="highest-125"><ns3:description>Evaluation of highest function.</ns3:description><ns3:created by="Christian Gruen" on="2026-10-02"/><ns3:test>highest(('a', 'B', 'c'), 'http://www.w3.org/2005/xpath-functions/collation/codepoint')</ns3:test><ns3:result><ns3:assert-eq>'c'</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-126"><ns3:description>Evaluation of highest function.</ns3:description><ns3:created by="Christian Gruen" on="2026-10-02"/><ns3:test>highest(('a', 'B', 'b'), 'http://www.w3.org/2005/xpath-functions/collation/html-ascii-case-insensitive')</ns3:test><ns3:result><ns3:assert-deep-eq>'B', 'b'</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-127"><ns3:description>Evaluation of highest function.</ns3:description><ns3:created by="Christian Gruen" on="2026-10-02"/><ns3:test>highest(('a', 'b'), ())</ns3:test><ns3:result><ns3:assert-eq>'b'</ns3:assert-eq></ns3:result></ns3:test-case><ns3:test-case name="highest-128"><ns3:description>Evaluation of highest function.</ns3:description><ns3:created by="Christian Gruen" on="2026-10-02"/><ns3:test>highest(('a', 'b'), 'http://example.com/unknown-collation')</ns3:test><ns3:result><ns3:error code="FOCH0002"/></ns3:result></ns3:test-case><ns3:test-case name="highest-901"><ns3:description>test highest() second argument is a call on a function with the wrong signature</ns3:description><ns3:created by="Michael Kay" on="2014-04-13"/><ns3:test>
         highest(doc('highest/highest-005.xml')/*/*, (), round#2)   
      </ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case><ns3:test-case name="highest-902"><ns3:description>test highest() implicit string-to-double conversion fails</ns3:description><ns3:created by="Michael Kay" on="2014-04-13"/><ns3:test>
         highest(doc('highest/highest-003.xml')/*/*)        
      </ns3:test><ns3:result><ns3:error code="FORG0001"/></ns3:result></ns3:test-case></ns3:test-set>