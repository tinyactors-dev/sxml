<?xml version="1.0" encoding="UTF-8"?><ns3:test-set xmlns:ns3="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-all-different" covers-40="PR156" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><ns3:description>Tests for the fn:all-different function (previously named "unique")</ns3:description><ns3:link type="spec" document="http://www.w3.org/TR/xpath-functions-30/" idref="func-all-different"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test-case name="all-different-001"><ns3:description>Empty sequence</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different(())</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-002"><ns3:description>Single integer</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different(1)</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-003"><ns3:description>Single string</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different("x")</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-004"><ns3:description>Integers</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different((1, 1))</ns3:test><ns3:result><ns3:assert-false/></ns3:result></ns3:test-case><ns3:test-case name="all-different-005"><ns3:description>Identical integers</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different((1 to 1000) ! 1)</ns3:test><ns3:result><ns3:assert-false/></ns3:result></ns3:test-case><ns3:test-case name="all-different-006"><ns3:description>Identical strings</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different((1 to 1000) ! 'x')</ns3:test><ns3:result><ns3:assert-false/></ns3:result></ns3:test-case><ns3:test-case name="all-different-007"><ns3:description>Integer range</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different((1 to 2))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-008"><ns3:description>Integers</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different((1, 2, 3))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-009"><ns3:description>Strings</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different((1, 2, 3) ! string())</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-010"><ns3:description>Items of different type</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different((1, '1'))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-011"><ns3:description>Numbers of different type</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different((1, 1.0, 1e0))</ns3:test><ns3:result><ns3:assert-false/></ns3:result></ns3:test-case><ns3:test-case name="all-different-012"><ns3:description>Element with filter expression</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>fn:all-different(&lt;a/&gt;[. = ''])</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-013"><ns3:description>Elements with filter expression</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>fn:all-different((&lt;a/&gt;, &lt;b/&gt;)[. = ''])</ns3:test><ns3:result><ns3:assert-false/></ns3:result></ns3:test-case><ns3:test-case name="all-different-014"><ns3:description>Element with filter expression</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>fn:all-different(&lt;a/&gt;[. != ''])</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-015"><ns3:description>Elements with filter expression</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>fn:all-different((&lt;a/&gt;, &lt;b/&gt;)[. != ''])</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-016"><ns3:description>Empty array</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different([])</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-017"><ns3:description>Array with single member</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different([ 1 ])</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-018"><ns3:description>Array with uniform members</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different([ 1, 1 ])</ns3:test><ns3:result><ns3:assert-false/></ns3:result></ns3:test-case><ns3:test-case name="all-different-019"><ns3:description>Array with distinct members</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different([ 1, 2 ])</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-020"><ns3:description>Dynamic range expression</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>fn:all-different((1 to &lt;_&gt;1&lt;/_&gt;/text()))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-021"><ns3:description>Dynamic range expression</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>fn:all-different((1 to &lt;_&gt;2&lt;/_&gt;/text()))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-022"><ns3:description>Replicated filter expression</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different(replicate((1 to 100)[. &lt; 1], 100))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-023"><ns3:description>Replicated filter expression</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different(replicate((1 to 100)[. &lt; 2], 100))</ns3:test><ns3:result><ns3:assert-false/></ns3:result></ns3:test-case><ns3:test-case name="all-different-024"><ns3:description>Replicated filter expression</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different(replicate((1 to 100)[. &lt; 3], 100))</ns3:test><ns3:result><ns3:assert-false/></ns3:result></ns3:test-case><ns3:test-case name="all-different-025"><ns3:description>Reversed strings</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different(reverse((1 to 10) ! string()))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-026"><ns3:description>Sorted strings</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different(sort((1 to 10) ! string()))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-027"><ns3:description>Strings and collation</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different(('A', 'a'), "http://www.w3.org/2005/xpath-functions/collation/html-ascii-case-insensitive")</ns3:test><ns3:result><ns3:assert-false/></ns3:result></ns3:test-case><ns3:test-case name="all-different-028"><ns3:description>Strings and collation</ns3:description><ns3:created by="Christian Gruen" on="2022-08-09"/><ns3:test>fn:all-different(('A', 'b'), "http://www.w3.org/2005/xpath-functions/collation/html-ascii-case-insensitive")</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-029"><ns3:description>Collation set to ()</ns3:description><ns3:created by="Michael Kay" on="2023-07-04"/><ns3:test>fn:all-different(('A', 'B'), ())</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-030"><ns3:description>Collation set to ()</ns3:description><ns3:created by="Michael Kay" on="2023-07-04"/><ns3:test>fn:all-different(('A', 'B'), collation:=())</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-031"><ns3:description>Collation set to ()</ns3:description><ns3:created by="Michael Kay" on="2023-07-04"/><ns3:test>fn:all-different(('A', 'B'), collation:="xyz"[current-date() lt xs:date('1999-01-01')])</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-032"><ns3:description>Mix of floats and doubles</ns3:description><ns3:created by="Michael Kay" on="2023-12-03"/><ns3:test>fn:all-different((xs:float('1.2'), xs:double('1.2')))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-033"><ns3:description>Mix of decimals and doubles</ns3:description><ns3:created by="Michael Kay" on="2023-12-03"/><ns3:test>fn:all-different((xs:decimal('1.2'), xs:double('1.2')))</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="all-different-034"><ns3:description>Mix of decimals and doubles all integral</ns3:description><ns3:created by="Michael Kay" on="2023-12-03"/><ns3:test>fn:all-different((xs:decimal('1'), xs:double('1')))</ns3:test><ns3:result><ns3:assert-false/></ns3:result></ns3:test-case><ns3:test-case name="all-different-035"><ns3:description>Negative zero</ns3:description><ns3:created by="Michael Kay" on="2025-10-01"/><ns3:test>fn:all-different((0.0e0, -0.0e0))</ns3:test><ns3:result><ns3:assert-false/></ns3:result></ns3:test-case></ns3:test-set>