<?xml version="1.0" encoding="UTF-8"?><ns3:test-set xmlns:ns3="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-function-annotations" covers-40="PR710" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><ns3:description>Tests for the function-annotations() function</ns3:description><ns3:link type="spec" document="http://www.w3.org/TR/xpath-functions-40/" idref="func-function-annotations"/><ns3:dependency type="feature" value="higherOrderFunctions"/><ns3:dependency type="spec" value="XP40+ XQ40+"/><ns3:test-case name="fn-function-annotations-001"><ns3:description>No arguments</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:test>fn:function-annotations()</ns3:test><ns3:result><ns3:error code="XPST0017"/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-002"><ns3:description>Arity zero</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:test>fn:function-annotations#0</ns3:test><ns3:result><ns3:error code="XPST0017"/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-003"><ns3:description>Two arguments</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:test>fn:function-annotations(fn:dateTime#2, fn:dateTime#2)</ns3:test><ns3:result><ns3:error code="XPST0017"/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-004"><ns3:description>Arity two</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:test>fn:function-annotations#2</ns3:test><ns3:result><ns3:error code="XPST0017"/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-005"><ns3:description>Arity one, existence check</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:test>exists(fn:function-annotations#1)</ns3:test><ns3:result><ns3:assert-true/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-006"><ns3:description>Empty sequence as argument</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:test>fn:function-annotations( () )</ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-007"><ns3:description>Argument of type xs:anyAtomicType</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:test>fn:function-annotations( 1 )</ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-008"><ns3:description>Argument of type node()</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:test>fn:function-annotations( fn:analyze-string((), "unused") )</ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-009"><ns3:description>Argument, type checking</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:test>fn:function-annotations( (fn:concat#2, fn:concat#3) )</ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-010"><ns3:description>Argument, dynamic type checking</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:dependency type="feature" value="staticTyping"/><ns3:test>fn:function-annotations( if ( fn:current-dateTime() eq
                                    fn:dateTime( fn:current-date(),
                                                 fn:current-time() ))
                               then fn:dateTime#2
                               else 1 )</ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-011"><ns3:description>Argument, dynamic type checking</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:test>( fn:function-annotations( if (current-date() eq xs:date('1900-01-01'))
                                 then fn:dateTime#2
                                 else 1 ),
              fn:function-annotations( if (current-date() eq xs:date('1900-01-01'))
                                 then 1
                                 else fn:dateTime#2 ) )</ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-012"><ns3:description>Argument, dynamic type checking</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:dependency type="feature" value="staticTyping"/><ns3:test>fn:function-annotations( if ( fn:current-dateTime() eq
                                    fn:dateTime( fn:current-date(),
                                                 fn:current-time() ))
                               then fn:dateTime#2
                               else () )</ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-013"><ns3:description>Argument, dynamic type checking</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:test>( fn:function-annotations( if (current-date() eq xs:date('1900-01-01'))
                                 then fn:dateTime#2
                                 else () ),
              fn:function-annotations( if (current-date() eq xs:date('1900-01-01'))
                                 then ()
                                 else fn:dateTime#2 ) )</ns3:test><ns3:result><ns3:error code="XPTY0004"/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-014"><ns3:description>Test return type</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:modified by="Michael Kay" on="2024-12-19"/><ns3:test>fn:function-annotations( fn:substring#2 )</ns3:test><ns3:result><ns3:assert-type>map(xs:QName, xs:anyAtomicType*)*</ns3:assert-type></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-015"><ns3:description>Result for built-in function: key</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:test>fn:function-annotations(true#0) ! map:keys(.)</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-016"><ns3:description>Result for built-in function: value</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:test>fn:function-annotations(true#0) ! map:items(.)</ns3:test><ns3:result><ns3:assert-empty/></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-017"><ns3:description>Function item</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:modified by="Michael Kay" on="2024-08-19" change="spec change, PR1393"/><ns3:modified by="Michael Kay" on="2024-08-19" change="spec change, PR1666"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>
declare %private function local:inc($c) { $c + 1 };
function-annotations(local:inc#1)
       </ns3:test><ns3:result><ns3:assert-deep-eq>map { QName('http://www.w3.org/2012/xquery', 'private'): () }</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-018" covers-40="PR1828"><ns3:description>Partial function application: annotations are retained</ns3:description><ns3:created by="Christian Gruen" on="2023-09-17"/><ns3:modified by="Michael Kay" on="2024-08-19" change="spec change, PR1393"/><ns3:modified by="Michael Kay" on="2024-08-19" change="spec change, PR1666"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>
let $f := %Q{uri}name('a', 'b') function($a, $b) {}
return function-annotations($f(?, 5))
      </ns3:test><ns3:result><ns3:assert-deep-eq>map { QName('uri', 'name'): ('a', 'b') }</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-019"><ns3:description>Multiple annotations</ns3:description><ns3:created by="Michael Kay" on="2024-08-19"/><ns3:modified by="Michael Kay" on="2024-08-19" change="spec change, PR1666"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>
declare %private %local:optimized(true()) function local:inc($c) { $c + 1 };
function-annotations(local:inc#1) =&gt; map:merge()
       </ns3:test><ns3:result><ns3:assert-deep-eq>map { QName('http://www.w3.org/2012/xquery', 'private'): (),
                               QName('http://www.w3.org/2005/xquery-local-functions', 'optimized'): true() }
         </ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-020"><ns3:description>Multiple annotations, duplicate names</ns3:description><ns3:created by="Michael Kay" on="2024-08-19"/><ns3:modified by="Michael Kay" on="2024-08-19" change="spec change, PR1666"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>
declare %private %local:optimized(true()) %local:optimized(false()) function local:inc($c) { $c + 1 };
function-annotations(local:inc#1)
       </ns3:test><ns3:result><ns3:assert-deep-eq>map { QName('http://www.w3.org/2012/xquery', 'private'): () },
                         map { QName('http://www.w3.org/2005/xquery-local-functions', 'optimized'): true() },
                         map { QName('http://www.w3.org/2005/xquery-local-functions', 'optimized'): false() }
         </ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-021" covers-40="PR1828"><ns3:description>Explicit annotations on inline function expression</ns3:description><ns3:created by="Michael Kay" on="2025-02-21"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>
let $f := %Q{http://local/}incremental(true()) function ($c) { $c + 1 }
return function-annotations($f)
       </ns3:test><ns3:result><ns3:assert-deep-eq>map { QName('http://local/', 'incremental'): true() }</ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-022" covers-40="PR1828"><ns3:description>Explicit multiple annotations on inline function expression</ns3:description><ns3:created by="Michael Kay" on="2025-02-21"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>
let $f := %Q{http://local/}color("red") %Q{http://local/}color("green") function ($c) { $c + 1 }
return function-annotations($f)
       </ns3:test><ns3:result><ns3:assert-deep-eq>
            { QName('http://local/', 'color'): "red" },
            { QName('http://local/', 'color'): "green" }
         </ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-023" covers-40="PR1828"><ns3:description>Annotations retained by partial application</ns3:description><ns3:created by="Michael Kay" on="2025-02-21"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>
let $f := %Q{http://local/}color("red") %Q{http://local/}color("green") function ($c, $d) { $c + $d }
return function-annotations($f(?, 1))
       </ns3:test><ns3:result><ns3:assert-deep-eq>
            { QName('http://local/', 'color'): "red" },
            { QName('http://local/', 'color'): "green" }
         </ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-024" covers-40="PR2061"><ns3:description>QName-valued annotations</ns3:description><ns3:created by="Michael Kay" on="2025-06-30"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>
declare %private %local:charm(#local:absent) function local:inc($c) { $c + 1 };
function-annotations(local:inc#1) =&gt; map:merge()
       </ns3:test><ns3:result><ns3:assert-deep-eq>map { QName('http://www.w3.org/2012/xquery', 'private'): (),
                               QName('http://www.w3.org/2005/xquery-local-functions', 'charm'): QName('http://www.w3.org/2005/xquery-local-functions', 'absent') }
         </ns3:assert-deep-eq></ns3:result></ns3:test-case><ns3:test-case name="fn-function-annotations-025"><ns3:description>Evaluation of function-annotations function.</ns3:description><ns3:created by="Christian Gruen" on="2026-10-04"/><ns3:dependency type="spec" value="XQ40+"/><ns3:test>(%local:x fn() { 1 }, %local:y fn() { 1 }) ! map:keys(function-annotations(.)) ! local-name-from-QName(.)</ns3:test><ns3:result><ns3:assert-deep-eq>"x", "y"</ns3:assert-deep-eq></ns3:result></ns3:test-case></ns3:test-set>