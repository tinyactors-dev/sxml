<?xml version="1.0" encoding="UTF-8"?>
<!--
  The spec's articles (spec/README.md). This schema is the contract that
  queries and updates rely on: every article validates against it, and
  tools/spec/spec writes nothing that does not. The words are in
  spec/README.md, "Words".
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
           vc:minVersion="1.1"
           elementFormDefault="unqualified">

  <!-- ==== Articles ==== -->

  <xs:element name="decision">
    <xs:annotation><xs:documentation>A choice that was made and why.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="title" type="inline"/>
        <xs:element name="summary" type="inline" minOccurs="0"/>
        <xs:element name="body" type="blocks"/>
      </xs:sequence>
      <xs:attribute name="id" use="required" type="decision-identifier"/>
      <xs:attribute name="status" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:token">
            <xs:enumeration value="accepted"/>
            <xs:enumeration value="superseded"/>
            <xs:enumeration value="unused">
              <xs:annotation><xs:documentation>A number no decision has, recorded so that text citing it resolves; not on the page.</xs:documentation></xs:annotation>
            </xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="superseded-by" type="decision-identifier"/>
      <xs:assert test="(@status = 'superseded') = exists(@superseded-by)"/>
      <xs:assert test="not(@superseded-by = @id)"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="proposal">
    <xs:annotation><xs:documentation>Something put to the owner and not yet decided.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="title" type="inline"/>
        <xs:element name="summary" type="inline" minOccurs="0"/>
        <xs:element name="body" type="blocks"/>
      </xs:sequence>
      <xs:attribute name="id" use="required" type="slug"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="term">
    <xs:annotation><xs:documentation>One spelling of one concept. Its identifier is its first name and does not change when it is renamed.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="name" type="xs:token" maxOccurs="unbounded"/>
        <xs:element name="definition" type="inline" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" use="required" type="xs:token"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="packet">
    <xs:annotation><xs:documentation>A unit of work an agent takes. Its state is the status element at the start of its body.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="title" type="inline"/>
        <xs:element name="summary" type="inline" minOccurs="0"/>
        <xs:element name="body" type="blocks"/>
      </xs:sequence>
      <xs:attribute name="id" use="required" type="packet-identifier"/>
      <xs:assert test="count(.//status) le 1 and (empty(.//status) or exists(body/*[1]/status))"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="log-entry">
    <xs:annotation><xs:documentation>One section of the log: a week, or the questions at a gate.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="title" type="inline"/>
        <xs:element name="body" type="blocks"/>
      </xs:sequence>
      <xs:attribute name="id" use="required" type="slug"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="document">
    <xs:annotation><xs:documentation>A page people read: its own text, and the articles it includes, in order.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="title" type="inline"/>
        <xs:element name="summary" type="inline" minOccurs="0"/>
        <xs:group ref="content"/>
      </xs:sequence>
      <xs:attribute name="id" use="required" type="document-identifier"/>
      <xs:attribute name="file" use="required">
        <xs:annotation><xs:documentation>The Markdown page `tools/spec/spec generate` writes from it.</xs:documentation></xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string"><xs:pattern value="docs/[A-Za-z0-9_/\-]+\.md"/></xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
    <xs:unique name="section-identifiers">
      <xs:selector xpath=".//section"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>


  <!-- ==== Identifiers ==== -->

  <xs:simpleType name="decision-identifier">
    <xs:restriction base="xs:token"><xs:pattern value="D[1-9][0-9]*[a-z]?"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="packet-identifier">
    <xs:restriction base="xs:token"><xs:pattern value="[0-9]+\.[0-9]+[a-z]?|[a-z]+(-[a-z]+)*-[0-9]+|xml-mem"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="slug">
    <xs:restriction base="xs:token"><xs:pattern value="[a-z0-9]+(-[a-z0-9]+)*"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="document-identifier">
    <xs:restriction base="xs:token"><xs:pattern value="[A-Za-z0-9_\-]+(/[A-Za-z0-9_\-]+)*"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="kind">
    <xs:restriction base="xs:token">
      <xs:enumeration value="decision"/>
      <xs:enumeration value="proposal"/>
      <xs:enumeration value="term"/>
      <xs:enumeration value="packet"/>
      <xs:enumeration value="log-entry"/>
      <xs:enumeration value="document"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ==== Structure ==== -->

  <xs:group name="content">
    <xs:sequence>
      <xs:group ref="block" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="section" type="section" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="block" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:group>

  <xs:complexType name="section">
    <xs:sequence>
      <xs:element name="title" type="inline"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="block"/>
        <xs:element name="section" type="section"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="id" use="required" type="xs:token"/>
    <xs:attribute name="level" type="heading-level">
      <xs:annotation><xs:documentation>The heading level, when it is not one more than its parent's.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="heading-level">
    <xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="6"/></xs:restriction>
  </xs:simpleType>

  <xs:complexType name="blocks">
    <xs:group ref="block" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>

  <xs:complexType name="include">
    <xs:annotation><xs:documentation>The place of an article in a document.</xs:documentation></xs:annotation>
    <xs:attribute name="kind" use="required" type="kind"/>
    <xs:attribute name="to" use="required" type="xs:token"/>
  </xs:complexType>

  <xs:complexType name="collect">
    <xs:annotation><xs:documentation>The place of every article of a kind in a document, in order: decisions by number, the others by identifier. A new article of that kind needs no change to the document.</xs:documentation></xs:annotation>
    <xs:attribute name="kind" use="required" type="kind"/>
  </xs:complexType>

  <xs:group name="block">
    <xs:choice>
      <xs:element name="p" type="inline"/>
      <xs:element name="heading">
        <xs:complexType mixed="true">
          <xs:group ref="inline-element" minOccurs="0" maxOccurs="unbounded"/>
          <xs:attribute name="level" use="required" type="heading-level"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="list">
        <xs:complexType>
          <xs:choice maxOccurs="unbounded">
            <xs:element name="item">
              <xs:complexType>
                <xs:group ref="block" minOccurs="0" maxOccurs="unbounded"/>
                <xs:attribute name="checked" type="xs:boolean"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="include" type="include"/>
            <xs:element name="collect" type="collect"/>
          </xs:choice>
          <xs:attribute name="ordered" type="xs:boolean"/>
          <xs:attribute name="start" type="xs:nonNegativeInteger"/>
          <xs:attribute name="loose" type="xs:boolean"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="pre">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="language" type="xs:token"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="table">
        <xs:complexType>
          <xs:choice maxOccurs="unbounded">
            <xs:element name="row">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="cell" type="inline" maxOccurs="unbounded"/>
                </xs:sequence>
                <xs:attribute name="header" type="xs:boolean"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="include" type="include"/>
            <xs:element name="collect" type="collect"/>
          </xs:choice>
          <xs:attribute name="align">
            <xs:simpleType>
              <xs:list>
                <xs:simpleType>
                  <xs:restriction base="xs:token">
                    <xs:enumeration value="default"/>
                    <xs:enumeration value="left"/>
                    <xs:enumeration value="right"/>
                    <xs:enumeration value="center"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:list>
            </xs:simpleType>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="quote" type="blocks"/>
      <xs:element name="rule"><xs:complexType/></xs:element>
      <xs:element name="comment" type="xs:string"/>
      <xs:element name="include" type="include"/>
      <xs:element name="collect" type="collect"/>
    </xs:choice>
  </xs:group>

  <!-- ==== Inline content ==== -->

  <xs:complexType name="inline" mixed="true">
    <xs:group ref="inline-element" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>

  <xs:group name="inline-element">
    <xs:choice>
      <xs:element name="code" type="xs:string"/>
      <xs:element name="term">
        <xs:annotation><xs:documentation>A use of a glossary term, written as code.</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:attribute name="name" use="required" type="xs:token"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="ref">
        <xs:complexType>
          <xs:attribute name="kind" use="required" type="kind"/>
          <xs:attribute name="to" use="required" type="xs:token"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="strong" type="inline"/>
      <xs:element name="em" type="inline"/>
      <xs:element name="link">
        <xs:complexType mixed="true">
          <xs:group ref="inline-element" minOccurs="0" maxOccurs="unbounded"/>
          <xs:attribute name="href" use="required" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="recorded">
        <xs:annotation><xs:documentation>"Recorded DATE": when a decision was recorded.</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:attribute name="date" use="required" type="xs:date"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="status">
        <xs:annotation><xs:documentation>A packet's state, written at the start of its body.</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:attribute name="value" use="required">
            <xs:simpleType>
              <xs:restriction base="xs:token">
                <xs:enumeration value="done"/>
                <xs:enumeration value="paused"/>
                <xs:enumeration value="design"/>
                <xs:enumeration value="designed"/>
                <xs:enumeration value="revised"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
          <xs:attribute name="date" type="xs:date"/>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>
</xs:schema>
