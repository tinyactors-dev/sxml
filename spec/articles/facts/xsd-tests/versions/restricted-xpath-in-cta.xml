<fact id="xsd-tests/versions/restricted-xpath-in-cta">
  <title>Occurrences of the version token restricted-xpath-in-CTA in the XSD test suite</title>
  <expression>count(doc("third_party/xsdtests/suite.xml")/*:testSuite/*:testSetRef ! doc(resolve-uri(@*:href, base-uri(.)))//@version ! tokenize(.)[. = "restricted-xpath-in-CTA"])</expression>
  <source file="third_party/xsdtests/suite.xml"/>
</fact>
