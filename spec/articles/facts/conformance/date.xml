<fact id="conformance/date">
  <title>The date of the commit the conformance report measured</title>
  <expression>replace(unparsed-text-lines("docs/CONFORMANCE.md")[starts-with(., "- Code under test:")][1], "^.* of ([0-9-]+).*$", "$1")</expression>
  <source file="docs/CONFORMANCE.md" written-by="tools/conformance-report.py"/>
</fact>
