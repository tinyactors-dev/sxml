<fact id="qt4-catalog/assertions/all-of">
  <title>Occurrences of all-of in the results of the QT4 catalog's test cases</title>
  <expression>let $cases := doc("third_party/qt4tests/catalog.xml")/*:catalog/*:test-set ! doc(resolve-uri(@file, base-uri(.)))//*:test-case
return count($cases/*:result/descendant-or-self::*:all-of)</expression>
  <source file="third_party/qt4tests/catalog.xml"/>
</fact>
