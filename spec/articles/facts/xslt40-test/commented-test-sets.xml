<fact id="xslt40-test/commented-test-sets">
  <title>Test-set entries commented out in the xslt40-test catalog</title>
  <expression>sum(doc("third_party/xslt40-test/catalog.xml")//comment() ! (count(tokenize(., "&lt;test-set")) - 1))</expression>
  <source file="third_party/xslt40-test/catalog.xml"/>
</fact>
