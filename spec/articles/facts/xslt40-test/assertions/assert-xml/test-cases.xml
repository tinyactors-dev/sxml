<fact id="xslt40-test/assertions/assert-xml/test-cases">
  <title>Test cases of xslt40-test with assert-xml in the result</title>
  <expression>let $sets := doc("third_party/xslt40-test/catalog.xml")/*:catalog/*:test-set
let $cases := $sets ! doc(resolve-uri(@file, base-uri(.)))//*:test-case
return count($cases[*:result/descendant-or-self::*:assert-xml])</expression>
  <source file="third_party/xslt40-test/catalog.xml"/>
</fact>
