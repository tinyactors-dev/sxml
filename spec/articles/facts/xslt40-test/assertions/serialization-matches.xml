<fact id="xslt40-test/assertions/serialization-matches">
  <title>Occurrences of serialization-matches in the results of xslt40-test's test cases</title>
  <expression>let $sets := doc("third_party/xslt40-test/catalog.xml")/*:catalog/*:test-set
let $cases := $sets ! doc(resolve-uri(@file, base-uri(.)))//*:test-case
return count($cases/*:result/descendant-or-self::*:serialization-matches)</expression>
  <source file="third_party/xslt40-test/catalog.xml"/>
</fact>
