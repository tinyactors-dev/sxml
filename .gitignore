# Build trees (one per CMake preset).
/build/

# Pinned Node.js tools (ast-grep, tree-sitter-cli), installed by `npm ci --prefix tools`.
/tools/node_modules/

# Python bytecode from tools/*.py.
__pycache__/

# SwiftPM build trees and state (Package.swift, D238).
/.build/
/.swiftpm/

# The website's npm packages (website/, mise run site).
/website/node_modules/
