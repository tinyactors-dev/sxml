<?xml version="1.0" encoding="UTF-8"?>
<!-- The services after the change to flag-service 2.4.0: it no longer
     reads the flag cache, it records each kill with a new audit service,
     and its calls to the registry changed. -->
<diagram title="Vane services after the change">
  <node id="gateway" label="api-gateway"/>
  <node id="flags" label="flag-service" class="changed"/>
  <node id="registry" label="flag-registry"/>
  <node id="cache" label="flag-cache" kind="store" class="removed"/>
  <node id="audit" label="audit-service" class="added"/>
  <node id="database" label="postgresql" kind="store"/>
  <edge from="gateway" to="flags" label="HTTP"/>
  <edge from="flags" to="registry" label="HTTP" class="changed"/>
  <edge from="flags" to="cache" label="Redis" class="removed"/>
  <edge from="flags" to="audit" label="HTTP" class="added"/>
  <edge from="registry" to="database" label="SQL"/>
  <edge from="audit" to="database" label="SQL" class="added"/>
</diagram>
