<?xml version="1.0" encoding="UTF-8"?>
<!-- The services of the Vane system and who calls whom. A node is a box;
     kind="store" draws a data store. An edge goes from the caller to the
     service it calls. The layout is computed: diagram.svg is the drawing. -->
<diagram title="Vane services">
  <node id="gateway" label="api-gateway"/>
  <node id="flags" label="flag-service"/>
  <node id="registry" label="flag-registry"/>
  <node id="cache" label="flag-cache" kind="store"/>
  <node id="database" label="postgresql" kind="store"/>
  <edge from="gateway" to="flags" label="HTTP"/>
  <edge from="flags" to="registry" label="HTTP"/>
  <edge from="flags" to="cache" label="Redis"/>
  <edge from="registry" to="database" label="SQL"/>
</diagram>
