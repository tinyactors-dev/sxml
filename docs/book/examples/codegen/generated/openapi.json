{
  "openapi": "3.1.0",
  "info": {
    "title": "vane",
    "version": "1.0.0"
  },
  "paths": {
    "/api/getFlags": {
      "get": {
        "operationId": "getFlags",
        "summary": "Every flag with its rules, for an SDK that evaluates flags itself.",
        "tags": [
          "node"
        ],
        "responses": {
          "200": {
            "description": "The output",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlagSet"
                }
              }
            }
          },
          "400": {
            "description": "The input is not valid"
          }
        },
        "parameters": [
          {
            "name": "input",
            "in": "query",
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlagsRequest"
                }
              }
            }
          }
        ]
      }
    },
    "/api/evaluateFlags": {
      "get": {
        "operationId": "evaluateFlags",
        "summary": "Whether each flag is on for one user, for an SDK in a browser page.",
        "tags": [
          "browser"
        ],
        "responses": {
          "200": {
            "description": "The output",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evaluations"
                }
              }
            }
          },
          "400": {
            "description": "The input is not valid"
          }
        },
        "parameters": [
          {
            "name": "input",
            "in": "query",
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationContext"
                }
              }
            }
          }
        ]
      }
    },
    "/api/getStatus": {
      "get": {
        "operationId": "getStatus",
        "summary": "The state of one flag and its failed checks since the last rollout step.",
        "tags": [
          "browser",
          "node"
        ],
        "responses": {
          "200": {
            "description": "The output",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlagStatus"
                }
              }
            }
          },
          "400": {
            "description": "The input is not valid"
          }
        },
        "parameters": [
          {
            "name": "input",
            "in": "query",
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusRequest"
                }
              }
            }
          }
        ]
      }
    },
    "/api/rollOutFlag": {
      "post": {
        "operationId": "rollOutFlag",
        "summary": "Rolls a flag out to a new percentage once its guardrail checks pass.",
        "tags": [
          "console"
        ],
        "responses": {
          "200": {
            "description": "The output",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlagStatus"
                }
              }
            }
          },
          "400": {
            "description": "The input is not valid"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RolloutRequest"
              }
            }
          }
        }
      }
    },
    "/api/killFlag": {
      "post": {
        "operationId": "killFlag",
        "summary": "Turns a flag off for every user at once.",
        "tags": [
          "console"
        ],
        "responses": {
          "200": {
            "description": "The output",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KillResult"
                }
              }
            }
          },
          "400": {
            "description": "The input is not valid"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KillRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FlagKey": {
        "type": "string",
        "pattern": "^(?:[a-z0-9][a-z0-9-]*)$",
        "maxLength": 64
      },
      "Owner": {
        "type": "string",
        "pattern": "^(?:[^@ ]+@[^@ ]+)$"
      },
      "Environment": {
        "type": "string",
        "enum": [
          "production",
          "staging"
        ]
      },
      "State": {
        "type": "string",
        "enum": [
          "stable",
          "rolling-out",
          "paused"
        ]
      },
      "Percentage": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "FailureCount": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10
      },
      "Seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600
      },
      "Rule": {
        "type": "object",
        "properties": {
          "attribute": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "percentage": {
            "$ref": "#/components/schemas/Percentage"
          }
        },
        "required": [
          "attribute",
          "values",
          "percentage"
        ],
        "additionalProperties": false
      },
      "FlagConfig": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/components/schemas/FlagKey"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "percentage": {
            "$ref": "#/components/schemas/Percentage"
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Rule"
            }
          }
        },
        "required": [
          "key",
          "state",
          "percentage",
          "rules"
        ],
        "additionalProperties": false
      },
      "FlagsRequest": {
        "type": "object",
        "properties": {
          "environment": {
            "$ref": "#/components/schemas/Environment"
          }
        },
        "required": [
          "environment"
        ],
        "additionalProperties": false
      },
      "FlagSet": {
        "type": "object",
        "properties": {
          "flags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlagConfig"
            }
          }
        },
        "required": [
          "flags"
        ],
        "additionalProperties": false
      },
      "Attribute": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "value"
        ],
        "additionalProperties": false
      },
      "EvaluationContext": {
        "type": "object",
        "properties": {
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "user": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attribute"
            }
          }
        },
        "required": [
          "environment",
          "user",
          "attributes"
        ],
        "additionalProperties": false
      },
      "Evaluation": {
        "type": "object",
        "properties": {
          "flag": {
            "$ref": "#/components/schemas/FlagKey"
          },
          "on": {
            "type": "boolean"
          }
        },
        "required": [
          "flag",
          "on"
        ],
        "additionalProperties": false
      },
      "Evaluations": {
        "type": "object",
        "properties": {
          "evaluations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evaluation"
            }
          }
        },
        "required": [
          "evaluations"
        ],
        "additionalProperties": false
      },
      "StatusRequest": {
        "type": "object",
        "properties": {
          "flag": {
            "$ref": "#/components/schemas/FlagKey"
          }
        },
        "required": [
          "flag"
        ],
        "additionalProperties": false
      },
      "FlagStatus": {
        "type": "object",
        "properties": {
          "flag": {
            "$ref": "#/components/schemas/FlagKey"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "failedChecks": {
            "$ref": "#/components/schemas/FailureCount"
          },
          "retryAfter": {
            "$ref": "#/components/schemas/Seconds"
          }
        },
        "required": [
          "flag",
          "state",
          "failedChecks"
        ],
        "additionalProperties": false
      },
      "RolloutRequest": {
        "type": "object",
        "properties": {
          "flag": {
            "$ref": "#/components/schemas/FlagKey"
          },
          "percentage": {
            "$ref": "#/components/schemas/Percentage"
          },
          "owner": {
            "$ref": "#/components/schemas/Owner"
          }
        },
        "required": [
          "flag",
          "percentage",
          "owner"
        ],
        "additionalProperties": false
      },
      "KillRequest": {
        "type": "object",
        "properties": {
          "flag": {
            "$ref": "#/components/schemas/FlagKey"
          },
          "owner": {
            "$ref": "#/components/schemas/Owner"
          }
        },
        "required": [
          "flag",
          "owner"
        ],
        "additionalProperties": false
      },
      "KillResult": {
        "type": "object",
        "properties": {
          "flag": {
            "$ref": "#/components/schemas/FlagKey"
          },
          "killed": {
            "type": "boolean"
          }
        },
        "required": [
          "flag",
          "killed"
        ],
        "additionalProperties": false
      }
    }
  }
}
