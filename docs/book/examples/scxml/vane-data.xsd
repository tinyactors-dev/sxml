<?xml version="1.0" encoding="UTF-8"?>
<!-- The data of the feature flag machine (flag.scxml): the types of its
     data model items and the payloads of its events. The machine names
     these types with vane:type and vane:payload attributes, so the schema
     documents the data and a schema-aware query can check it. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
           xmlns:vane="urn:example:vane"
           targetNamespace="urn:example:vane"
           elementFormDefault="qualified"
           vc:minVersion="1.1">

  <!-- Data model items -->

  <xs:simpleType name="failure-count">
    <xs:restriction base="xs:nonNegativeInteger"/>
  </xs:simpleType>

  <xs:simpleType name="failure-limit">
    <xs:restriction base="xs:positiveInteger">
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="seconds">
    <xs:restriction base="xs:positiveInteger">
      <xs:maxInclusive value="3600"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A value of a data model item, written as text, can be checked
       against its type: <vane:value xsi:type="vane:seconds">300</vane:value> -->
  <xs:element name="value" type="xs:anySimpleType"/>

  <!-- Values that the protocol defines (draft-example-vane-protocol, Messages) -->

  <xs:simpleType name="flag-key">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9\-]{1,32}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="percentage">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{1,3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="state">
    <xs:restriction base="xs:string">
      <xs:enumeration value="stable"/>
      <xs:enumeration value="rolling-out"/>
      <xs:enumeration value="paused"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Event payloads -->

  <xs:element name="rollout">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="flag" type="vane:flag-key"/>
        <xs:element name="percentage" type="vane:percentage"/>
        <xs:element name="owner" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="status">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="flag" type="vane:flag-key"/>
        <xs:element name="state" type="vane:state"/>
        <xs:element name="failed-checks" type="vane:failure-count"/>
        <xs:element name="retry-after" type="vane:seconds" minOccurs="0"/>
      </xs:sequence>
      <!-- Only a paused flag says when to try again. -->
      <xs:assert test="exists(vane:retry-after) = (vane:state = 'paused')"/>
    </xs:complexType>
  </xs:element>

  <!-- Annotations on the machine -->

  <xs:attribute name="type" type="xs:QName"/>
  <xs:attribute name="payload" type="xs:QName"/>
  <!-- The anchors of the requirements a state or transition carries out. -->
  <xs:attribute name="implements">
    <xs:simpleType>
      <xs:list itemType="xs:NCName"/>
    </xs:simpleType>
  </xs:attribute>

  <xs:element name="events">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="event" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:any namespace="http://www.w3.org/1999/xhtml" processContents="lax"
                      minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:token" use="required"/>
            <xs:attribute ref="vane:payload"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="event-name">
      <xs:selector xpath="vane:event"/>
      <xs:field xpath="@name"/>
    </xs:unique>
  </xs:element>
</xs:schema>
