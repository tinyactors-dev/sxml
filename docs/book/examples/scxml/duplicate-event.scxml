<?xml version="1.0" encoding="UTF-8"?>
<!-- A machine that declares one of its events twice. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:latch="urn:example:latch"
       version="1.0" name="small_lock" initial="locked">
  <latch:events>
    <latch:event name="lock.request"/>
    <latch:event name="unlock.request" latch:payload="latch:credentials"/>
    <latch:event name="lock.request"/>
  </latch:events>
  <state id="locked">
    <transition event="unlock.request" target="unlocked"/>
  </state>
  <state id="unlocked">
    <transition event="lock.request" target="locked"/>
  </state>
</scxml>
