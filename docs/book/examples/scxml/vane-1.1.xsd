<?xml version="1.0" encoding="UTF-8"?>
<!-- XSD 1.1 on the latch annotations: latch-data.xsd, overridden and
     extended. Give it to the validator together with scxml.xsd: its
     override then stands for latch-data.xsd, which scxml.xsd imports. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
           xmlns:latch="urn:example:latch"
           targetNamespace="urn:example:latch"
           elementFormDefault="qualified"
           defaultAttributes="latch:traced"
           vc:minVersion="1.1">

  <xs:override schemaLocation="latch-data.xsd">
    <!-- An event's type depends on whether it carries a payload. -->
    <xs:element name="events">
      <xs:complexType>
        <xs:sequence>
          <xs:element name="event" type="latch:event" maxOccurs="unbounded">
            <xs:alternative test="@latch:payload" type="latch:event-with-payload"/>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:unique name="event-name">
        <xs:selector xpath="latch:event"/>
        <xs:field xpath="@name"/>
      </xs:unique>
    </xs:element>

    <!-- A status may end with elements of other namespaces, so that a
         vendor can add its own fields. -->
    <xs:element name="status">
      <xs:complexType>
        <xs:openContent mode="suffix">
          <xs:any namespace="##other" processContents="lax"/>
        </xs:openContent>
        <xs:sequence>
          <xs:element name="door" type="latch:door-id"/>
          <xs:element name="state" type="latch:state"/>
          <xs:element name="failed-attempts" type="latch:attempt-count"/>
          <xs:element name="retry-after" type="latch:seconds" minOccurs="0"/>
        </xs:sequence>
        <xs:assert test="exists(latch:retry-after) = (latch:state = 'lockout')"/>
      </xs:complexType>
    </xs:element>
  </xs:override>

  <!-- A delay as SCXML writes it, such as "10s" or "250ms", of at most
       an hour: the pattern checks the form, the assertion the size. -->
  <xs:simpleType name="delay">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]+(s|ms)"/>
      <xs:assertion test="xs:integer(replace($value, '[a-z]+$', ''))
                          le (if (ends-with($value, 'ms')) then 3600000 else 3600)"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A moment in a log: a date and time that says its timezone. -->
  <xs:simpleType name="moment">
    <xs:restriction base="xs:dateTime">
      <xs:explicitTimezone value="required"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Every complex type of this document gets these attributes. -->
  <xs:attributeGroup name="traced">
    <xs:attribute ref="latch:implements"/>
  </xs:attributeGroup>

  <!-- An event without a payload: the XHTML description is optional. -->
  <xs:complexType name="event">
    <xs:sequence>
      <xs:any namespace="http://www.w3.org/1999/xhtml" processContents="lax"
              minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:token" use="required"/>
    <xs:attribute ref="latch:payload"/>
  </xs:complexType>

  <!-- An event with a payload must say in XHTML what it carries. -->
  <xs:complexType name="event-with-payload">
    <xs:complexContent>
      <xs:restriction base="latch:event">
        <xs:sequence>
          <xs:any namespace="http://www.w3.org/1999/xhtml" processContents="lax"
                  minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:token" use="required"/>
        <xs:attribute ref="latch:payload" use="required"/>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>
