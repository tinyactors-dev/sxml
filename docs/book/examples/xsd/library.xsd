<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="library">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="shelf" type="shelf" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
    <!-- Every book id is unique in the library. -->
    <xs:unique name="book-id">
      <xs:selector xpath="shelf/book"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

  <xs:complexType name="shelf">
    <xs:sequence>
      <xs:element name="book" type="book" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="book">
    <xs:sequence>
      <xs:element name="title" type="xs:string"/>
      <xs:element name="author" type="xs:string" maxOccurs="unbounded"/>
      <xs:element name="price" type="price"/>
      <xs:element name="tags" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="tag" type="xs:token" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="year" type="xs:gYear" use="required"/>
    <xs:attribute name="pages" type="xs:positiveInteger"/>
  </xs:complexType>

  <!-- A price is a decimal with two places, and a currency. -->
  <xs:complexType name="price">
    <xs:simpleContent>
      <xs:extension base="amount">
        <xs:attribute name="currency" type="currency" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:simpleType name="amount">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:fractionDigits value="2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="currency">
    <xs:restriction base="xs:string">
      <xs:enumeration value="EUR"/>
      <xs:enumeration value="USD"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
