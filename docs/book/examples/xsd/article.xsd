<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:attributeGroup name="dated">
    <xs:attribute name="created" type="xs:date" use="required"/>
    <xs:attribute name="changed" type="xs:date"/>
  </xs:attributeGroup>

  <xs:group name="credits">
    <xs:sequence>
      <xs:element name="author" type="xs:string" maxOccurs="unbounded"/>
      <xs:element name="editor" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:group>

  <xs:element name="article">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="title" type="xs:string"/>
        <xs:group ref="credits"/>
      </xs:sequence>
      <xs:attributeGroup ref="dated"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="review">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="credits"/>
        <xs:element name="rating" type="xs:integer"/>
      </xs:sequence>
      <xs:attributeGroup ref="dated"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
