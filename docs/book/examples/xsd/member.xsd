<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="member">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="name" type="name"/>
        <xs:element name="email" type="email"/>
        <xs:element name="joined" type="xs:date"/>
        <xs:element name="level" type="level"/>
        <xs:element name="limit" type="limit"/>
        <xs:element name="interests" type="interests"/>
        <xs:element name="phone" type="phone"/>
      </xs:sequence>
      <xs:attribute name="id" type="member-id" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- An M and four digits. -->
  <xs:simpleType name="member-id">
    <xs:restriction base="xs:string">
      <xs:pattern value="M[0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A token has no leading, trailing or double spaces. -->
  <xs:simpleType name="name">
    <xs:restriction base="xs:token">
      <xs:minLength value="1"/>
      <xs:maxLength value="40"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="email">
    <xs:restriction base="xs:string">
      <xs:pattern value="[^@\s]+@[^@\s]+\.[^@\s]+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="level">
    <xs:restriction base="xs:string">
      <xs:enumeration value="basic"/>
      <xs:enumeration value="plus"/>
      <xs:enumeration value="staff"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- How many books a member may borrow at once. -->
  <xs:simpleType name="limit">
    <xs:restriction base="xs:positiveInteger">
      <xs:maxInclusive value="20"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A list: values separated by spaces. -->
  <xs:simpleType name="interest-list">
    <xs:list itemType="xs:NCName"/>
  </xs:simpleType>

  <xs:simpleType name="interests">
    <xs:restriction base="interest-list">
      <xs:maxLength value="3"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A union: a phone number, or the word "unlisted". -->
  <xs:simpleType name="phone">
    <xs:union>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="\+[0-9 ]{6,20}"/>
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="unlisted"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>
</xs:schema>
