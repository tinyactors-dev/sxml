<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="copies">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="copy" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="isbn" type="isbn" use="required"/>
            <xs:attribute name="checked" type="moment" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- An ISBN-13: thirteen digits whose weighted sum ends in 0. -->
  <xs:simpleType name="isbn">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{13}"/>
      <xs:assertion test="
        let $digits := string-to-codepoints($value) ! (. - 48)
        return sum(for $i in 1 to 13
                   return $digits[$i] * (if ($i mod 2 = 0) then 3 else 1)) mod 10 = 0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A moment in time: a dateTime that must have a timezone. -->
  <xs:simpleType name="moment">
    <xs:restriction base="xs:dateTime">
      <xs:explicitTimezone value="required"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
