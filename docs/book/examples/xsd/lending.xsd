<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://example.org/lending"
           xmlns="https://example.org/lending"
           xmlns:money="https://example.org/money"
           elementFormDefault="qualified">

  <!-- Same namespace: include. Another namespace: import. -->
  <xs:include schemaLocation="people.xsd"/>
  <xs:import namespace="https://example.org/money" schemaLocation="money.xsd"/>

  <xs:element name="fines">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="fine" type="fine" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="fine">
    <xs:sequence>
      <xs:element name="member" type="member"/>
      <xs:element name="amount" type="money:amount"/>
    </xs:sequence>
    <xs:attribute name="book" type="xs:NCName" use="required"/>
  </xs:complexType>
</xs:schema>
