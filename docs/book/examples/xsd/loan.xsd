<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="loan">
    <xs:complexType>
      <xs:attribute name="book" type="xs:NCName" use="required"/>
      <xs:attribute name="from" type="xs:date" use="required"/>
      <xs:attribute name="until" type="xs:date" use="required"/>
      <!-- XSD 1.1: a rule that connects two values. -->
      <xs:assert test="@until gt @from"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
