<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           defaultAttributes="common">

  <!-- defaultAttributes: these attributes are allowed on every
       complex type of the schema. -->
  <xs:attributeGroup name="common">
    <xs:attribute name="note" type="xs:string"/>
  </xs:attributeGroup>

  <xs:element name="acquisitions">
    <xs:complexType>
      <!-- Open content: elements of other namespaces may appear
           anywhere between the declared children. -->
      <xs:openContent mode="interleave">
        <xs:any namespace="##other" processContents="lax"/>
      </xs:openContent>
      <xs:sequence>
        <xs:element name="item" type="item" maxOccurs="unbounded">
          <!-- Conditional type assignment: the type depends on @kind. -->
          <xs:alternative test="@kind = 'book'" type="book"/>
          <xs:alternative test="@kind = 'film'" type="film"/>
          <xs:alternative type="xs:error"/>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="budget" type="xs:decimal" use="required"/>
      <!-- An assertion over the whole element. -->
      <xs:assert test="sum(item/price) le @budget"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="item">
    <xs:sequence>
      <xs:element name="title" type="xs:string"/>
      <xs:element name="price" type="xs:decimal"/>
    </xs:sequence>
    <xs:attribute name="kind" type="xs:token" use="required"/>
  </xs:complexType>

  <xs:complexType name="book">
    <xs:complexContent>
      <xs:extension base="item">
        <xs:sequence>
          <xs:element name="author" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="film">
    <xs:complexContent>
      <xs:extension base="item">
        <xs:sequence>
          <xs:element name="minutes" type="xs:positiveInteger"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>
