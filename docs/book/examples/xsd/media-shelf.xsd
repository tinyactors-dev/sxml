<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="media.xsd"/>

  <!-- The head of a substitution group, and two members. -->
  <xs:element name="entry" type="item" abstract="true"/>
  <xs:element name="book" type="book" substitutionGroup="entry"/>
  <xs:element name="film" type="film" substitutionGroup="entry"/>

  <xs:element name="shelf">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="entry" maxOccurs="unbounded"/>
        <!-- A date, or explicitly nothing. -->
        <xs:element name="checked" type="xs:date" nillable="true"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
