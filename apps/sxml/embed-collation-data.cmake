# Writes OUTPUT, a C file that embeds INPUT, the DUCET
# (third_party/unicode-collation/allkeys.txt, UTS #10, section 9.1), without
# its comments and blank lines, for the sxml command's resolver (D213). The
# text is split into string literals of at most about 4,000 bytes, below the
# 4,095 that C17 (5.2.4.1) asks compilers to support, so -Wpedantic has
# nothing to say; the resolver of apps/sxml/query_command.c joins them.
#
#   cmake -DINPUT=allkeys.txt -DOUTPUT=sxml_collation_data.c -P embed-collation-data.cmake

file(READ "${INPUT}" text)
string(REGEX REPLACE "#[^\n]*" "" text "${text}")
string(REGEX REPLACE "[ \t\r]+\n" "\n" text "${text}")
string(REGEX REPLACE "\n\n+" "\n" text "${text}")
string(REGEX REPLACE "^\n" "" text "${text}")
# Lines become list elements: ";" is CMake's separator, so it is carried
# as "|", which the data does not use, and put back below.
string(REPLACE "|" "" text "${text}")
string(REPLACE ";" "|" text "${text}")
string(REPLACE "\n" ";" text "${text}")
set(chunks "")
set(chunk "")
set(chunk_count 0)
foreach(line IN LISTS text)
    if(line STREQUAL "")
        continue()
    endif()
    string(APPEND chunk "${line}\\n")
    string(LENGTH "${chunk}" chunk_length)
    if(chunk_length GREATER 3900)
        string(APPEND chunks "    \"${chunk}\",\n")
        set(chunk "")
        math(EXPR chunk_count "${chunk_count} + 1")
    endif()
endforeach()
if(NOT chunk STREQUAL "")
    string(APPEND chunks "    \"${chunk}\",\n")
    math(EXPR chunk_count "${chunk_count} + 1")
endif()
string(REPLACE "|" ";" chunks "${chunks}")
file(WRITE "${OUTPUT}" "/* Generated by apps/sxml/embed-collation-data.cmake from
   third_party/unicode-collation/allkeys.txt; do not edit. */
#include \"collation_data.h\"

static const char *const sxml_cli_collation_chunks[${chunk_count}] = {
${chunks}};

sxml_cli_text_chunks sxml_cli_collation_data(void) {
    return (sxml_cli_text_chunks){.chunks = sxml_cli_collation_chunks,
                                  .chunk_count = ${chunk_count}};
}
")
