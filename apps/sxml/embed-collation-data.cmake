# Writes OUTPUT, a C file that embeds the collation data the sxml command
# serves to the UCA collation feature (D213, D220): each INPUTS item is
# PATH=FILE, the path under CLDR's common/ directory the feature asks for
# ("urn:sxml:collation-data:" + PATH) and the vendored file
# (third_party/cldr/common/PATH). A .txt file (the root's allkeys_CLDR.txt,
# UTS #10, section 9.1) loses its comments and blank lines; an .xml file
# (LDML) is kept as it is. The text is split into string literals of at
# most about 4,000 bytes, below the 4,095 that C17 (5.2.4.1) asks compilers
# to support, so -Wpedantic has nothing to say; the resolver of
# apps/sxml/query_command.c joins them. INPUTS separates its items with
# "|".
#
#   cmake "-DINPUTS=uca/allkeys_CLDR.txt=/x/allkeys_CLDR.txt|collation/de.xml=/x/de.xml"
#         -DOUTPUT=sxml_collation_data.c -P embed-collation-data.cmake

string(REPLACE "|" ";" inputs "${INPUTS}")
set(files_text "")
set(arrays_text "")
set(file_count 0)
foreach(input IN LISTS inputs)
    string(FIND "${input}" "=" separator)
    string(SUBSTRING "${input}" 0 ${separator} path)
    math(EXPR file_start "${separator} + 1")
    string(SUBSTRING "${input}" ${file_start} -1 file)
    file(READ "${file}" text)
    if(path MATCHES "\\.txt$")
        string(REGEX REPLACE "#[^\n]*" "" text "${text}")
        string(REGEX REPLACE "[ \t\r]+\n" "\n" text "${text}")
        string(REGEX REPLACE "\n\n+" "\n" text "${text}")
        string(REGEX REPLACE "^\n" "" text "${text}")
    endif()
    # C string literal escapes.
    string(REPLACE "\\" "\\\\" text "${text}")
    string(REPLACE "\"" "\\\"" text "${text}")
    string(REPLACE "\t" "\\t" text "${text}")
    string(REPLACE "\r" "" text "${text}")
    # Lines become list elements: ";" is CMake's separator and brackets
    # change how it splits, so they are carried as markers the data does not
    # have and put back below.
    string(REPLACE ";" "@sxml-semicolon@" text "${text}")
    string(REPLACE "[" "@sxml-open@" text "${text}")
    string(REPLACE "]" "@sxml-close@" text "${text}")
    string(REPLACE "\n" ";" text "${text}")
    set(chunks "")
    set(chunk "")
    set(chunk_count 0)
    foreach(line IN LISTS text)
        string(APPEND chunk "${line}\\n")
        string(LENGTH "${chunk}" chunk_length)
        if(chunk_length GREATER 3900)
            string(APPEND chunks "    \"${chunk}\",\n")
            set(chunk "")
            math(EXPR chunk_count "${chunk_count} + 1")
        endif()
    endforeach()
    if(NOT chunk STREQUAL "")
        string(APPEND chunks "    \"${chunk}\",\n")
        math(EXPR chunk_count "${chunk_count} + 1")
    endif()
    string(REPLACE "@sxml-semicolon@" ";" chunks "${chunks}")
    string(REPLACE "@sxml-open@" "[" chunks "${chunks}")
    string(REPLACE "@sxml-close@" "]" chunks "${chunks}")
    string(APPEND arrays_text "static const char *const sxml_cli_collation_chunks_${file_count}[${chunk_count}] = {
${chunks}};

")
    string(APPEND files_text "    {.path = \"${path}\",
     .text = {.chunks = sxml_cli_collation_chunks_${file_count}, .chunk_count = ${chunk_count}}},
")
    math(EXPR file_count "${file_count} + 1")
endforeach()
file(WRITE "${OUTPUT}" "/* Generated by apps/sxml/embed-collation-data.cmake from
   third_party/cldr; do not edit. */
#include \"collation_data.h\"

${arrays_text}static const sxml_cli_collation_file sxml_cli_collation_files[${file_count}] = {
${files_text}};

sxml_cli_collation_file_view sxml_cli_collation_data(void) {
    return (sxml_cli_collation_file_view){.files = sxml_cli_collation_files,
                                          .file_count = ${file_count}};
}
")
